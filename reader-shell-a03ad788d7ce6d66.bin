  }
  /** 画面上的当前句字幕，随显示模式：仅英文 → 只英；含中文的模式 → 英+中；仅中文 → 只中 */
  function renderVideoSub() {
    var box = $('video-sub'), c = state.activeCue !== null ? state.cueById[state.activeCue] : null;
    if (!state.videoSub || state.mediaType !== 'video' || !c || state.blind) { box.innerHTML = ''; return; }
    box.innerHTML = (state.zhMode !== 'only' ? '<div class="vs-en">' + esc(c.en) + '</div>' : '') + (state.zhMode !== 'off' && c.zh ? '<div class="vs-zh">' + esc(c.zh) + '</div>' : '');
  }
  function applyMask() { var m = $('mask'); m.classList.toggle('hidden', !state.mask.on); m.style.top = state.mask.top + '%'; m.style.height = state.mask.height + '%'; $('mask-toggle').classList.toggle('active', state.mask.on); }
