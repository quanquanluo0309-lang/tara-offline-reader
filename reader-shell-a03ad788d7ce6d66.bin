  }
  function onTimeUpdate() {
    var m = mediaEl(), t = m.currentTime;
    updatePlayhead();
    if (state.loop) { if (t >= state.loop.end || t < state.loop.start - 0.2) { m.currentTime = state.loop.start; updateLoopBar(state.loop.start); return; } updateLoopBar(t); }
    var c = findCue(t), id = c ? c.i : null;
    if (id === state.activeCue) return;
    if (state.activeCue !== null) { var old = document.getElementById('cue-' + state.activeCue); if (old) old.classList.remove('active');
      var oldZh = document.querySelector('.zhc.active'); if (oldZh) oldZh.classList.remove('active'); }
    state.activeCue = id;
    renderVideoSub(); updatePlayhead(); updateLocNow(); updateTocNow(); updateParaNow();
    if (state.link.ps.a) revealSideNow();
    if (id !== null) { var el = document.getElementById('cue-' + id); if (el) { el.classList.add('active');
      var zhc = document.querySelector('.zhc[data-i="' + id + '"]'); if (zhc) zhc.classList.add('active');
      var sec = el.closest('section.sec'); if (sec && sec.classList.contains('folded')) sec.classList.remove('folded');
      if (!$('popover').classList.contains('show')) {   // 标注弹层开着时正文不动
        // 播放 → 正文：当前句离开视野就滚回中央，在视野内不动；正文内点击定位后 1 秒内不滚（localSeekGuard）。
        // 曾加过「上一句完整可见才算跟着读、否则不拉回」的判断，顺着读到屏幕底部时当前句只露一半就被判成翻走，跟随就停了——撤销（2026-09-28 用户反馈）
        if (Touch.followAllowed() && state.link.pp.a && Date.now() >= state.pageSkipUntil && !inView(el)) followScroll(el);
      } } }
    Touch.onCueChange();
  }
  /**
   * 正文跟随侧栏：侧栏当前 tab 的 ▶ 项换了（进入新的节 / 漏听段落），正文跳到它的标题，顶在页首，与单击侧栏落点一致。
   * 换 tab 或开开关时只记住当前项、不跳；▶ 消失（播放位置不在任何漏听段落里）时清空记忆，再进同一段落会再跳。
   */
  /** 页面很长，平滑滚动要一秒多且中途看不出落点；侧栏跳转一律瞬时定位，目标顶在页首（折叠的节先展开） */
  function jumpTo(id) {
    var target = document.getElementById(id); if (!target) return;
    var sec = target.closest ? target.closest('section.sec') : null; if (sec && sec.classList.contains('folded')) sec.classList.remove('folded');
    target.scrollIntoView({ block: 'start', behavior: 'auto' });
  }
  /**
   * 三对双向关系，每个按钮四态循环：A 方向开 → B 方向开 → 双向全开 → 全关（2026-09-28 用户）。
   *   ps 播放 ⇄ 侧栏：a = 侧栏 ▶ 项随播放滚到可见；b = 单击侧栏条目即把播放定位到那里（保持播放 / 暂停状态）
   *   pp 播放 ⇄ 正文：a = 当前句离开视野时正文滚回中央；b = 单击句子即把播放定位到那句（保持播放 / 暂停状态）
   *     ——不由滚动驱动：滚动是阅读动作，不是定位意图（2026-09-28 用户）；时间戳始终定位并保持播放状态，不受开关影响
   *   sp 侧栏 ⇄ 正文：a = 单击侧栏条目时正文跳到该处；b = 侧栏高亮并滚到阅读位置所在的节 / 漏听段落
   * 侧栏作为「来源」只指用户在侧栏的动作（单击），不转发播放位置：否则 播放 → 侧栏 → 正文 会成为暗链，
   * 只开「播放 ← 正文」时正文仍随播放跳（2026-09-28 用户反馈，循环 #34 时 ▶ 在嵌套的 #34 / #35 间来回切，正文跟着跳）。
   */
  var LINKS = { ps: { id: 'follow-side', A: '播放', B: '侧栏', da: '侧栏 ▶ 项随播放滚到可见', db: '单击侧栏条目即定位播放' },
                pp: { id: 'follow-page', A: '播放', B: '正文', da: '当前句离开视野时正文滚回中央', db: '单击句子即定位播放（时间戳始终定位并保持播放状态）' },
                sp: { id: 'follow-block', A: '侧栏', B: '正文', da: '单击侧栏条目时正文跳到该处', db: '侧栏高亮并滚到阅读位置所在的节 / 段落' } };
  function linkArrow(L) { return L.a && L.b ? '⇄' : L.a ? '→' : L.b ? '←' : '·'; }
  function applyFollowButtons() {
    Object.keys(LINKS).forEach(function (k) {
      var d = LINKS[k], L = state.link[k], btn = $(d.id), arrow = linkArrow(L);
      btn.classList.toggle('active', L.a || L.b); btn.classList.toggle('both', L.a && L.b);
      if (btn.classList.contains('edge-tab')) btn.innerHTML = esc(d.A) + '<span class="hz">' + arrow + '</span>' + esc(d.B);
      else btn.textContent = d.A + ' ' + arrow + ' ' + d.B;
      btn.title = d.A + ' → ' + d.B + '：' + d.da + '\n' + d.A + ' ← ' + d.B + '：' + d.db + '\n点击循环：' + d.A + ' → ' + d.B + ' ⟶ ' + d.A + ' ← ' + d.B + ' ⟶ 双向 ⟶ 全关。当前：' + linkState(L);
    });
  }
  function linkState(L) { return L.a && L.b ? '双向' : L.a ? '→' : L.b ? '←' : '全关'; }
  function cycleLink(k) {
    var L = state.link[k], d = LINKS[k];
    state.link[k] = (!L.a && !L.b) ? { a: true, b: false } : (L.a && !L.b) ? { a: false, b: true } : (!L.a && L.b) ? { a: true, b: true } : { a: false, b: false };
    L = state.link[k]; applyFollowButtons(); savePrefs();
    if (k === 'ps' && L.a) revealSideNow();
    if (k === 'pp' && L.a && state.activeCue !== null) { var el = document.getElementById('cue-' + state.activeCue); if (el && !inView(el)) { el.scrollIntoView({ block: 'center', behavior: 'smooth' }); } }
    if (k === 'sp' && L.b) updateScrollSpy();
    toast(d.A + ' ' + linkArrow(L) + ' ' + d.B + '：' + (L.a && L.b ? d.da + '；' + d.db : L.a ? d.da : L.b ? d.db : '全关'));
  }
  /**
   * 正文里的点击定位（时间戳、段落定位、各种 🔁 循环、关键句弹层、循环进度条）：用户正看着这里，
   * 这次定位引起的换句 / 换段，正文既不按块跳也不居中（侧栏照常跟），否则一点就跳走，打断阅读（2026-09-28 用户反馈）
