        else { if (state.sel.has(ci)) { state.sel.delete(ci); cueEl.classList.remove('sel'); } else { state.sel.add(ci); cueEl.classList.add('sel'); } }
        state.lastSel = ci; renderSelBar(); e.preventDefault(); return;
      }
    }
