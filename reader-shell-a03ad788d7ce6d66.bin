  /** 三对双向关系的偏好；兼容 2026-09-28 之前的单开关 follow 与同日早些的 followSide / followPage / followBlock */
  function loadLinkPrefs(p) {
    if (typeof p.follow === 'boolean') { state.link.ps.a = p.follow; state.link.pp.a = p.follow; }
