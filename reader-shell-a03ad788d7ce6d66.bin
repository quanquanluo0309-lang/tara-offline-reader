      tags += '<span class="key-tag" data-pi="' + k.pi + '" data-si="' + k.si + '" title="关键句 · 点击：循环 / 播放 / 编辑 / 提升 / 删除">句' + (k.si + 1) + '</span>';
    });
    // 句子本身不带 title：悬停弹出的长文本（所属漏听段落 + 大纲路径）用处不大还遮挡正文（2026-09-27 用户反馈）
    var aside = state.asideOf[c.i];
    return '<span class="cue' + (first ? ' first' : '') + (key ? ' key' : '') + (aside ? ' aside' : '') + '" id="cue-' + c.i + '" data-i="' + c.i + '">' +
      '<a class="ts" title="从 ' + fmt(c.s) + ' 定位，保持播放或暂停">' + fmt(c.s) + '</a><span class="cue-loop" data-loop="' + c.i + '" title="循环这一句（再点停止；快捷键 L 循环/停止当前句）">🔁</span>' + tags + miniChip(aside) + '<span class="en">' + enHtml(c) + '</span> ' +
      (c.zh ? '<span class="zh">' + esc(c.zh) + '</span>' : '') + '</span>';
  }
  function miniChip(spk) { return spk ? '<span class="spk mini spk-' + esc(spk) + '" title="插话">' + esc(SPK_NAME[spk] || spk) + '</span>' : ''; }
  function enHtml(c) {
    var hls = highlightsOf(c.i), out = '', pos = 0, t = c.en, pk = state.picking && state.picking.cue === c.i ? state.picking : null;
    // 触屏标注态正在选的词（pk）画在未标注的文字上；与已有标注重叠的选区在选词时就被拒绝
    var plain = function (a, b) { var s = t.slice(a, b); if (!pk || pk.end <= a || pk.start >= b) return esc(s); var x = Math.max(a, pk.start), y = Math.min(b, pk.end); return esc(t.slice(a, x)) + '<mark class="picking">' + esc(t.slice(x, y)) + '</mark>' + esc(t.slice(y, b)); };
    hls.forEach(function (h) {
      if (h.start < pos) return;
      out += plain(pos, h.start);
      out += '<mark class="hl hl-' + h.kind + (h.note ? ' has-note' : '') + '" data-id="' + h.id + '" title="' + esc(kindName(h.kind) + (h.note ? '：' + h.note : '')) + '">' + esc(t.slice(h.start, h.end)) + '</mark>';
      pos = h.end;
    });
    return out + plain(pos, t.length);
  }
  function highlightsOf(i) { return Object.values(state.highlights).filter(function (h) { return h.cue === i; }).sort(function (a, b) { return a.start - b.start; }); }
  function kindName(k) { return k === 'vocab' ? '生词 [[ ]]' : k === 'collocation' ? '搭配/语法 （[[ ]]）' : '疑问'; }
  function cuesIn(range) { var out = []; for (var i = range[0]; i <= range[1]; i++) if (state.cueById[i]) out.push(state.cueById[i]); return out; }

  function zhParaHtml(cs) {
    var parts = cs.filter(function (c) { return c.zh; }).map(function (c) { return miniChip(state.asideOf[c.i]) + '<span class="zhc' + (state.keyOwner[c.i] ? ' key' : '') + (state.asideOf[c.i] ? ' aside' : '') + '" data-i="' + c.i + '">' + esc(c.zh) + '</span>'; });
    return parts.length ? '<div class="zh-para">' + parts.join(' ') + '</div>' : '';
  }
  /**
   * 一节的正文：漏听段落是容器，结构段落（说话人的一轮）是容器里的叶子——包含关系只有一个方向。
   * 1. 覆盖本节的漏听段落按（起点早、跨度长）排序，逐个放进区间树：完全落在某块里的成为它的子块；
   *    只部分落在某块里的（两段部分重叠）在该块末尾截断，余下部分作为「续」块回到上层继续放置；
   *    跨节的段落按节裁开。于是一个漏听段落通常只有一个区块（标题栏 + 正文 + 结束线），
   *    只有部分重叠或跨节时才切成多块（首块带标题栏，后续块标「续」，末块带结束线）。
   * 2. 渲染时按句序走一遍块的区间：遇到子块整体渲染子块，其余句子按所属结构段落归并成 .para；
   *    结构段落被漏听段落的边界切开时，每一片都是独立的 .para（同一 data-lo/hi），片首重现说话人标签。
   * （2026-09-28 之前是反过来的：结构段落在外，每个结构段落里各切一块漏听段落，一段 30 秒的漏听段落
   *   会被说话人的一句「Yes.」切成四五个各带「续」标题的小块，包含关系读不出来——用户反馈。）
   */
  function sectionBodyHtml(sec) {
    var root = { ri: -1, lo: sec.cues[0], hi: sec.cues[1], children: [] };
    state.located.map(function (p, ri) { return { ri: ri, lo: Math.max(p.cues[0], root.lo), hi: Math.min(p.cues[1], root.hi) }; })
      .filter(function (pc) { return pc.lo <= pc.hi; })
      .sort(function (a, b) { return (a.lo - b.lo) || (b.hi - a.hi); })
      .forEach(function (pc) { placePiece(root, pc); });
    var paraOf = {};
    sec.paragraphs.forEach(function (p, pi) { for (var i = p.cues[0]; i <= p.cues[1]; i++) paraOf[i] = pi; });
    return nodeHtml(root, { sec: sec, paraOf: paraOf, prevSpeaker: null }, 0);
  }
  /** 把一块放进 node 的子树；返回超出 node 区间、需要上层继续放置的余下部分（没有则 null）。子块互不重叠、按起点有序 */
  function placePiece(node, pc) {
    if (pc.lo > node.hi) return pc;
    var kids = node.children;
    for (var k = 0; k < kids.length; k++) {
      if (pc.lo >= kids[k].lo && pc.lo <= kids[k].hi) { var rest = placePiece(kids[k], pc); return rest ? placePiece(node, rest) : null; }
    }
    var hi = Math.min(pc.hi, node.hi);
    kids.push({ ri: pc.ri, lo: pc.lo, hi: hi, children: [] });
    return pc.hi > hi ? { ri: pc.ri, lo: hi + 1, hi: pc.hi } : null;
  }
  function nodeHtml(node, ctx, depth) {
    var html = '', k = 0, buf = null, fresh = true;   // fresh：容器开头或刚渲染完一个子块，下一片段落要重现说话人标签
    var flush = function () {
      if (!buf) return;
      var p = ctx.sec.paragraphs[buf.pi], showSpk = fresh || p.speaker !== ctx.prevSpeaker;
      html += paraPieceHtml(p, buf.cues, showSpk); ctx.prevSpeaker = p.speaker; buf = null; fresh = false;
    };
    for (var i = node.lo; i <= node.hi; i++) {
      var ch = node.children[k];
      if (ch && ch.lo === i) { flush(); html += blockHtml(ch, ctx, depth); i = ch.hi; k++; fresh = true; continue; }
      var c = state.cueById[i]; if (!c) continue;
      var pi = ctx.paraOf[i]; if (pi === undefined) continue;
      if (!buf || buf.pi !== pi) { flush(); buf = { pi: pi, cues: [] }; }
      buf.cues.push(c);
    }
    flush();
    return html;
  }
  function blockHtml(node, ctx, depth) {
    var lp = state.located[node.ri], n = state.locOrder[node.ri];
    var head = node.lo === lp.cues[0] ? locHead(node.ri) : '<div class="loc-cont">↳ 续 · 漏听 #' + n + ' ' + esc(lp.label || '') + '</div>';
    var foot = node.hi === lp.cues[1] ? '<div class="loc-end">— 漏听 #' + n + ' 结束 —</div>' : '';
    return '<div class="loc-block depth-' + depth + (node.lo === lp.cues[0] ? '' : ' continued') + '" data-loc="' + node.ri + '">' + head + nodeHtml(node, ctx, depth + 1) + foot + '</div>';
  }
  /** 结构段落的一片（整段或被漏听段落边界切开的一截）：说话人色条 + 小段循环钮 + 英文句 + 段末中文 */
  function paraPieceHtml(p, cs, showSpk) {
    var chip = showSpk ? '<span class="spk spk-' + esc(p.speaker || 'Unknown') + '">' + esc(SPK_NAME[p.speaker] || p.speaker || '—') + '</span>' : '';
    return '<div class="para" data-speaker="' + esc(p.speaker || 'Unknown') + '" data-lo="' + p.cues[0] + '" data-hi="' + p.cues[1] + '">' +
      '<span class="para-loop" data-lo="' + p.cues[0] + '" data-hi="' + p.cues[1] + '" title="循环这一小段（说话人的一轮，' + (p.cues[1] - p.cues[0] + 1) + ' 句）；再点停止。快捷键 Shift+L 循环/停止正在播放的小段">🔁</span>' +
      '<p class="text">' + chip + cs.map(function (c, j) { return cueHtml(c, j === 0); }).join('') + '</p>' + zhParaHtml(cs) + '</div>';
  }
  function render() {
    var main = $('main'), st = foldAsides(state.structure || autoStructure(state.cues)), html = '';
    indexOverlay();
    var spks = {}; st.chapters.forEach(function (ch) { ch.sections.forEach(function (sec) { sec.paragraphs.forEach(function (p) { if (p.speaker) spks[p.speaker] = 1; }); }); });
    html += '<details class="reading-guide"' + (isMobileReader() ? '' : ' open') + '><summary>标记与操作说明</summary><p class="legend"><span style="background:var(--loc-bg);border-left:4px solid var(--loc-line)">漏听段落 = 带标题栏的区块</span><span style="background:var(--loc-bg);border:1px dashed var(--loc-line);border-left:4px solid var(--key-line)">嵌套 = 落在另一段落里的漏听段落</span><span style="background:var(--key-bg)">关键句（区块内，句N 标签，中英同标）</span>' +
            '<span style="background:var(--vocab-bg)">生词 [[ ]]</span><span style="background:var(--colloc-bg)">搭配/语法 （[[ ]]）</span><span style="background:var(--q-bg)">疑问</span>' +
            '<span>点时间戳定位 · 点 🔁 循环（保持播放状态）</span><span class="desktop-edit">选中词句即可标注</span></p>' +
            '<p class="legend legend-bars">' + Object.keys(spks).map(function (k) { return '<span class="bar-sample" data-speaker="' + esc(k) + '">' + esc(SPK_NAME[k] || k) + ' 的一轮</span>'; }).join('') +
            '<span>左侧细色条 = 说话人的一轮（结构段落）；色条断开 = 换了一轮或被漏听段落切开；点轮首 🔁 循环这一轮</span>' +
            '<span>区块之间的空隙 = 不同的漏听段落；「↳ 续」= 同一漏听段落与另一段部分重叠或跨节而接着上一块</span></p>';
    html += '</details>';
    st.chapters.forEach(function (ch, ci) {
      var c0 = state.cueById[ch.cues[0]], c1 = state.cueById[ch.cues[1]];
      html += '<section class="chapter" id="ch-' + ci + '"><h2 class="ch-title"><span class="num">' + (ci + 1) + '</span>' + esc(ch.title) +
              '<span class="t">' + (c0 ? fmt(c0.s) : '') + '–' + (c1 ? fmt(c1.e) : '') + '</span></h2>';
      ch.sections.forEach(function (sec, si) {
        var kind = sec.kind || 'content', s0 = state.cueById[sec.cues[0]], foldable = kind === 'ad' || kind === 'banter' || kind === 'outro';
        html += '<section class="sec kind-' + kind + (foldable ? ' folded' : '') + '" id="sec-' + ci + '-' + si + '" data-ci="' + ci + '" data-si="' + si + '">' +
                '<h3 class="sec-title">' + (KIND_NAME[kind] ? '<span class="t" style="margin:0 6px 0 0">' + KIND_NAME[kind] + '</span>' : '') + esc(sec.title) +
                '<span class="t">' + (s0 ? fmt(s0.s) : '') + ' · ' + (sec.cues[1] - sec.cues[0] + 1) + ' 句</span>' +
                (foldable ? '<span class="fold" data-fold="1">展开/收起</span>' : '') + '</h3><div class="sec-body">';
        html += sectionBodyHtml(sec) + '</div></section>';
      });
      html += '</section>';
    });
    main.innerHTML = html;
    state.sectionEls = Array.from(main.querySelectorAll('section.sec'));
    state.zhEls = Object.create(null);
    main.querySelectorAll('.zhc[data-i]').forEach(function (el) { state.zhEls[el.dataset.i] = el; });
    paintReveals();
    renderToc(st); renderLocList(); renderStats(); renderTimeline(); syncScrollPadding(); updateScrollSpy();
    if (state.activeCue !== null) { var ae = document.getElementById('cue-' + state.activeCue); if (ae) ae.classList.add('active'); var az = document.querySelector('.zhc[data-i="' + state.activeCue + '"]'); if (az) az.classList.add('active'); }
    state.visRange = null; updateParaNow();
    state.sel.forEach(function (i) { var se = document.getElementById('cue-' + i); if (se) se.classList.add('sel'); });
  }
  function renderToc(st) {
    var toc = $('toc');
    if (!state.structure) { toc.innerHTML = '<div class="hint">未加载结构文件：按时间自动分段，无章节目录。</div>'; return; }
    toc.innerHTML = st.chapters.map(function (ch, ci) {
      var c0 = state.cueById[ch.cues[0]];
      return '<div class="ch"><a href="#ch-' + ci + '" data-t="' + (c0 ? c0.s : '') + '">' + (ci + 1) + '. ' + esc(ch.title) + '<span class="t">' + (c0 ? fmt(c0.s) : '') + '</span></a>' +
        ch.sections.map(function (sec, si) { var s0 = state.cueById[sec.cues[0]];
          return '<a class="sec-link kind-' + (sec.kind || 'content') + '" href="#sec-' + ci + '-' + si + '" data-id="sec-' + ci + '-' + si + '" data-t="' + (s0 ? s0.s : '') + '">' + esc(sec.title) + '<span class="t">' + (s0 ? fmt(s0.s) : '') + '</span></a>'; }).join('') + '</div>';
    }).join('');
    updateTocNow();
  }
  function renderLocList() {
    var el = $('loclist');
    $('tab-loc').textContent = '漏听段落' + (state.located.length ? ' (' + state.located.length + ')' : '');
    if (!state.located.length) { el.innerHTML = '<div class="hint">未加载标记文件（.segments.json）。</div>'; return; }
    // 两种顺序：时间序 = 逐字稿出现顺序（线性阅读）；大纲序 = segments.json 的数组顺序（与自评页、播放器一致）。
    // 编号 #N 始终是出现顺序，和正文区块标题上的编号一致，换序只改排列不改编号。
    var entries = state.located.map(function (p, i) { return { p: p, i: i }; });
    if (state.locSort === 'time') entries.sort(function (a, b) { return a.p.startTime - b.p.startTime; });
    var sortBar = '<div class="loc-sort"><button data-locsort="time"' + (state.locSort === 'time' ? ' class="active"' : '') + ' title="按逐字稿出现顺序">时间序</button>' +
      '<button data-locsort="outline"' + (state.locSort === 'outline' ? ' class="active"' : '') + ' title="按自评大纲顺序（与播放器、自评页一致）">大纲序</button></div>';
    var hint = state.locSort === 'time' ? '按逐字稿出现顺序' : '按自评大纲顺序（编号仍为出现顺序）';
    el.innerHTML = sortBar + '<div class="hint">' + hint + ' · ✗ 没捕捉到 · ? 模糊 · 点击定位，▶ 播放</div>' + entries.map(function (x) {
      return '<a href="#loc-' + x.i + '" data-t="' + x.p.startTime + '"><b>#' + state.locOrder[x.i] + '</b> ' + esc(x.p.label || '段落') + '<span class="t">' + fmt(x.p.startTime) + (x.p.sentences.length ? ' · ' + x.p.sentences.length + ' 句' : '') + '</span></a>';
    }).join('');
    updateLocNow();
  }
  function renderStats() {
    var hs = Object.values(state.highlights), n = function (k) { return hs.filter(function (h) { return h.kind === k; }).length; };
    var ks = state.located.reduce(function (a, p) { return a + p.sentences.length; }, 0);
    var st = state.structure, secs = st ? st.chapters.reduce(function (a, c) { return a + c.sections.length; }, 0) : 0;
    $('stats').innerHTML = (st ? '<span>章 <b>' + st.chapters.length + '</b> · 节 <b>' + secs + '</b></span>' : '') +
      '<span>漏听段落 <b>' + state.located.length + '</b> · 关键句 <b>' + ks + '</b></span>' +
      '<span>生词 <b>' + n('vocab') + '</b> · 搭配 <b>' + n('collocation') + '</b> · 疑问 <b>' + n('question') + '</b></span>';
    $('title').title = state.cues.length + ' 句 · ' + (state.data.source || '') + ' · 标注按本机自动保存';
  }
  function rerenderCue(i) { var el = document.getElementById('cue-' + i); if (!el) return; el.querySelector('.en').innerHTML = enHtml(state.cueById[i]); }

  // ---------- 顶栏高度 → 滚动留白（顶栏随视口宽度换行，高度不固定） ----------
  function headerHeight() { return document.querySelector('header').offsetHeight; }
  var lastHeaderHeight = null;
  function syncScrollPadding() { var h = headerHeight(); if (h === lastHeaderHeight) return; lastHeaderHeight = h; document.documentElement.style.scrollPaddingTop = (h + 8) + 'px'; document.documentElement.style.setProperty('--hdr', h + 'px'); }
  window.addEventListener('resize', syncScrollPadding);
  if (typeof ResizeObserver !== 'undefined') new ResizeObserver(syncScrollPadding).observe(document.querySelector('header'));

  // ---------- 标记：本机持久化 / 导入导出 / 新建 / 编辑 / 选句 / 时间线 ----------
  var LOC_PREFIX = 'transcript-loc:';
  function saveLocated() { try { localStorage.setItem(LOC_PREFIX + state.hash, JSON.stringify({ base: state.locBase, located: state.located })); } catch (e) { toast('标记保存失败：' + e.message); } }
  function loadStoredLocated() { try { var v = localStorage.getItem(LOC_PREFIX + state.hash); return v ? JSON.parse(v) : null; } catch (e) { return null; } }
  function commit(msg) { saveLocated(); var y = window.scrollY; render(); window.scrollTo(0, y); if (msg) toast(msg); }
  function cueTimes(range) { return { startTime: state.cueById[range[0]].s, endTime: state.cueById[range[1]].e }; }
  /** 手动按时间标记用：与 [a,b] 重叠达到该句一半或 1 秒的句子都算在内（比「完整落入」宽松，符合边听边点的手感） */
  function cueRangeOverlap(a, b) {
    var hit = state.cues.filter(function (c) { var ov = Math.min(c.e, b) - Math.max(c.s, a); return ov > 0 && ov >= Math.min((c.e - c.s) * 0.5, 1); });
    return hit.length ? [hit[0].i, hit[hit.length - 1].i] : null;
  }
  /** 完整包含 range 的最内层漏听段落下标，无则 -1 */
  function containingParagraph(range, excludeIdx) {
    var best = -1;
    state.located.forEach(function (p, k) {
      if (k === excludeIdx || p.cues[0] > range[0] || p.cues[1] < range[1]) return;
      if (best < 0 || (p.cues[1] - p.cues[0]) < (state.located[best].cues[1] - state.located[best].cues[0])) best = k;
    });
    return best;
  }
  function addParagraph(range, label) { var tm = cueTimes(range); state.located.push({ label: label, startTime: tm.startTime, endTime: tm.endTime, cues: range.slice(), sentences: [], createdAt: Date.now() }); commit('已新建漏听段落'); }
  function addSentence(pi, range, label) { var tm = cueTimes(range), p = state.located[pi]; p.sentences.push({ label: label, startTime: tm.startTime, endTime: tm.endTime, cues: range.slice(), createdAt: Date.now() }); p.sentences.sort(function (a, b) { return a.startTime - b.startTime; }); commit('已新建关键句（属于：' + (p.label || '段落') + '）'); }
  function createFromRange(range) {
    var pi = containingParagraph(range, -1), c0 = state.cueById[range[0]];
    if (pi >= 0) { var l1 = prompt('关键句标签（属于：' + (state.located[pi].label || '段落') + '）\n' + fmt(c0.s) + ' 起 ' + (range[1] - range[0] + 1) + ' 句', ''); if (l1 === null) return; addSentence(pi, range, l1); }
    else { var l2 = prompt('新漏听段落的标签\n' + fmt(c0.s) + ' 起 ' + (range[1] - range[0] + 1) + ' 句', '段落 ' + fmt(c0.s)); if (l2 === null) return; addParagraph(range, l2); }
  }
  function parseTimeInput(v) { v = String(v).trim(); var m = /^(?:(\d+):)?(\d{1,2}):(\d{1,2}(?:\.\d+)?)$/.exec(v); if (m) return (+(m[1] || 0)) * 3600 + (+m[2]) * 60 + parseFloat(m[3]); var n = parseFloat(v); return isNaN(n) ? null : n; }
  function fmtIn(t) { var m = Math.floor(t / 60), sec = (t % 60).toFixed(1); return m + ':' + (sec.length < 4 ? '0' + sec : sec); }
  // 按当前播放位置标记：两次点击 = 起点、终点
  function markToggle() {
    var m = mediaEl(); if (!m.getAttribute('src')) { toast('先加载音频/视频'); return; }
    var btn = $('mark-btn');
    if (state.markStart === null) { state.markStart = m.currentTime; btn.textContent = '结束（' + fmt(state.markStart) + ' →）'; btn.classList.add('active'); renderMarkBar(); return; }
    var a = Math.min(state.markStart, m.currentTime), b = Math.max(state.markStart, m.currentTime);
    cancelMark();
    var range = cueRangeOverlap(a, b); if (!range) { toast('这段时间里没有字幕句'); return; }
    createFromRange(range);
  }
  function cancelMark() { state.markStart = null; var btn = $('mark-btn'); btn.textContent = '圈段'; btn.classList.remove('active'); renderMarkBar(); }
  function renderMarkBar() {
    var bar = $('markbar');
    if (state.markStart === null) { bar.classList.remove('show'); bar.innerHTML = ''; return; }
    bar.classList.add('show');
    bar.innerHTML = '<span>圈段中 · 起点 <b>' + fmt(state.markStart) + '</b>，播放到终点后点</span><button data-markact="end" class="primary">圈段结束</button><button data-markact="cancel">取消</button>';
  }
  function resetLocated() {
    if (!confirm('丢弃本机对段落标记的全部编辑，恢复页面内嵌的文件版？')) return;
    try { localStorage.removeItem(LOC_PREFIX + state.hash); } catch (e) {}
    state.located = JSON.parse(JSON.stringify(state.fileLocated || [])); var y = window.scrollY; render(); window.scrollTo(0, y); toast('已恢复文件版（' + state.located.length + ' 段）');
  }
  // 选句模式
  function toggleSelecting(on) {
    state.selecting = typeof on === 'boolean' ? on : !state.selecting;
    document.body.classList.toggle('selecting', state.selecting); $('select-btn').classList.toggle('active', state.selecting);
    if (!state.selecting) clearSel(); renderSelBar();
  }
  function clearSel() { state.sel.forEach(function (i) { var el = document.getElementById('cue-' + i); if (el) el.classList.remove('sel'); }); state.sel.clear(); document.querySelectorAll('.zhc.sel').forEach(function (e) { e.classList.remove('sel'); }); state.lastSel = null; renderSelBar(); }
  function selRange() { var lo = Infinity, hi = -Infinity; state.sel.forEach(function (id) { lo = Math.min(lo, id); hi = Math.max(hi, id); }); return state.sel.size ? [lo, hi] : null; }
  function renderSelBar() {
    var bar = $('selbar'), r = selRange();
    if (!state.selecting) { bar.classList.remove('show'); return; }
    bar.classList.add('show');
    bar.innerHTML = r ? '<span>已选 <b>' + state.sel.size + '</b> 句 · ' + fmt(state.cueById[r[0]].s) + '–' + fmt(state.cueById[r[1]].e) + '</span>' : '<span>点句子选中，Shift+点选一段</span>';
    bar.innerHTML += '<button data-selact="para"' + (r ? '' : ' disabled') + '>设为漏听段落</button><button data-selact="sent"' + (r ? '' : ' disabled') + '>设为关键句</button><button data-selact="clear">重选</button><button data-selact="exit">完成</button>';
  }
  function selAction(act) {
    var r = selRange();
    if (act === 'exit') { toggleSelecting(false); return; }
    if (act === 'clear') { clearSel(); return; }
    if (!r) return;
    if (act === 'para') { var l = prompt('新漏听段落的标签', '段落 ' + fmt(state.cueById[r[0]].s)); if (l === null) return; addParagraph(r, l); toggleSelecting(false); }
    if (act === 'sent') { var pi = containingParagraph(r, -1); if (pi < 0) { toast('所选句子不在任何漏听段落内：先「设为漏听段落」'); return; } var l2 = prompt('关键句标签（属于：' + (state.located[pi].label || '段落') + '）', ''); if (l2 === null) return; addSentence(pi, r, l2); toggleSelecting(false); }
  }
  // 段落编辑表单（就地替换标题栏内容）
  function openEdit(ri) {
    var head = document.getElementById('loc-' + ri), p = state.located[ri]; if (!head) return;
    head.innerHTML = '<div class="loc-edit"><span class="loc-num">漏听 #' + state.locOrder[ri] + '</span><input class="lbl" value="' + esc(p.label || '') + '" placeholder="标签">' +
      '<input class="tm" value="' + fmtIn(p.startTime) + '" title="开始 m:ss.s"> – <input class="tm" value="' + fmtIn(p.endTime) + '" title="结束 m:ss.s">' +
      '<button data-editsave="' + ri + '">保存</button><button data-editcancel="1">取消</button></div>';
    head.querySelector('.lbl').focus();
  }
  function applyEdit(ri, label, av, bv) {
    var p = state.located[ri], a = parseTimeInput(av), b = parseTimeInput(bv);
    if (a === null || b === null) { toast('时间格式：m:ss 或 m:ss.s'); return false; }
    if (a > b) { var x = a; a = b; b = x; }
    var range = cueRange(state.cues, a, b); if (!range) { toast('该时间范围内没有字幕句'); return false; }
    var tm = cueTimes(range); p.label = String(label).trim(); p.cues = range; p.startTime = tm.startTime; p.endTime = tm.endTime;
    commit('已保存段落'); return true;
  }
  function saveEdit(ri) { var head = document.getElementById('loc-' + ri), tms = head.querySelectorAll('.tm'); applyEdit(ri, head.querySelector('.lbl').value, tms[0].value, tms[1].value); }
  function deleteParagraph(ri) { var p = state.located[ri]; if (!confirm('删除「' + (p.label || '段落') + '」' + (p.sentences.length ? '及其 ' + p.sentences.length + ' 个关键句' : '') + '？')) return; state.located.splice(ri, 1); commit('已删除'); }
  function attachParagraph(ri) { var p = state.located[ri], pi = containingParagraph(p.cues, ri); if (pi < 0) return; var host = state.located[pi]; state.located.splice(ri, 1); if (pi > ri) pi--; host = state.located[pi]; host.sentences.push({ label: p.label, startTime: p.startTime, endTime: p.endTime, cues: p.cues, createdAt: p.createdAt || Date.now() }); host.sentences.sort(function (a, b) { return a.startTime - b.startTime; }); commit('已归入「' + (host.label || '段落') + '」'); }
  // 关键句操作（点标签弹出）
  function showKeyPopover(kt) {
    if (isMobileReader()) { Touch.keySheet(+kt.dataset.pi, +kt.dataset.si); return; }
    var pi = +kt.dataset.pi, si = +kt.dataset.si, sn = state.located[pi].sentences[si], pop = $('popover');
    pop.innerHTML = '<div class="sel">关键句 句' + (si + 1) + (sn.label ? '：' + esc(sn.label) : '') + '<br>属于漏听 #' + state.locOrder[pi] + ' ' + esc(state.located[pi].label || '') + '</div><div class="row">' +
      '<button data-kact="loop">🔁 循环本句</button><button data-kact="play">↦ 定位</button><button data-kact="label">✎ 标签</button><button data-kact="promote">⤴ 提升为段落</button><button data-kact="del" class="del">删除</button></div>';
    pop.querySelectorAll('[data-kact]').forEach(function (b) {
      b.onclick = function () {
        var act = b.dataset.kact; hidePopover();
        if (act === 'loop') { localSeekGuard(); setLoop({ startTime: sn.startTime, endTime: sn.endTime, label: '句' + (si + 1) + (sn.label ? ' ' + sn.label : ''), cues: sn.cues }); }
        else if (act === 'play') { localSeekGuard(); setLoop(null); seekKeep(sn.startTime); }
        else if (act === 'label') { var l = prompt('关键句标签', sn.label || ''); if (l === null) return; sn.label = l; commit('已改标签'); }
        else if (act === 'promote') { state.located[pi].sentences.splice(si, 1); state.located.push({ label: sn.label, startTime: sn.startTime, endTime: sn.endTime, cues: sn.cues, sentences: [], createdAt: sn.createdAt || Date.now() }); commit('已提升为独立漏听段落'); }
        else if (act === 'del') { if (!confirm('删除这句关键句？')) return; state.located[pi].sentences.splice(si, 1); commit('已删除关键句'); }
      };
    });
    placePopover(kt.getBoundingClientRect());
  }
  // 时间线
  function mediaDuration() { var d = mediaEl().duration; if (d && isFinite(d)) return d; var last = state.cues[state.cues.length - 1]; return last ? last.e : 0; }
  function renderTimeline() {
    var tl = $('timeline'), D = mediaDuration(); if (!D) { tl.innerHTML = '<div class="tl-head" style="left:0"></div>'; return; }
    var html = '';
    state.located.forEach(function (p, i) {
      html += '<div class="tl-p" style="left:' + (p.startTime / D * 100) + '%;width:' + Math.max((p.endTime - p.startTime) / D * 100, 0.2) + '%" title="漏听 #' + state.locOrder[i] + ' ' + esc(p.label || '') + '"></div>';
      p.sentences.forEach(function (sn, j) { html += '<div class="tl-s" style="left:' + (sn.startTime / D * 100) + '%;width:' + Math.max((sn.endTime - sn.startTime) / D * 100, 0.15) + '%" title="句' + (j + 1) + ' ' + esc(sn.label || '') + '"></div>'; });
    });
    tl.innerHTML = html + '<div class="tl-head" style="left:0"></div>'; updatePlayhead(); Touch.renderMarks();
  }
  function updatePlayhead() { var D = mediaDuration(), h = $('timeline').querySelector('.tl-head'); if (h && D) h.style.left = (mediaEl().currentTime / D * 100) + '%'; }
  $('timeline').addEventListener('click', function (e) { var r = $('timeline').getBoundingClientRect(), D = mediaDuration(); if (D) { localSeekGuard(); seekKeep((e.clientX - r.left) / r.width * D); } });
  function exportSegments() {
    if (!state.located.length) { toast('还没有标记'); return; }
    var base = (state.audioName || '').split('/').pop();
    var data = { version: 2, exportedAt: new Date().toISOString(), mediaFileName: base || undefined, segments: state.located.map(function (p, i) {
      return { kind: 'paragraph', startTime: p.startTime, endTime: p.endTime, label: p.label || '', createdAt: p.createdAt || Date.now(), order: i,
        sentences: p.sentences.map(function (sn, j) { return { kind: 'sentence', startTime: sn.startTime, endTime: sn.endTime, label: sn.label || '', createdAt: sn.createdAt || Date.now(), order: j }; }) };
    }) };
    download((state.data.slug || 'transcript') + '.segments.json', JSON.stringify(data, null, 2)); toast('已导出 segments.json（' + state.located.length + ' 段）');
  }
  $('select-btn').onclick = function () { toggleSelecting(); };
  $('mark-btn').onclick = markToggle;
  $('export-seg').onclick = exportSegments;
  $('reset-seg').onclick = resetLocated;

  // ---------- 目录 scrollspy ----------
  var spyTick = false;
  function updateScrollSpy() {
    if (!state.sectionEls.length || (isMobileReader() && document.body.classList.contains('t-drawer-open'))) return;
    // 节按文档顺序排列且互不重叠：二分找最后一个顶边在阈值之上的节，不必每帧遍历全部节
    var top = headerHeight() + 12, els = state.sectionEls, lo = 0, hi = els.length - 1, current = null;
    while (lo <= hi) { var mid = (lo + hi) >> 1; if (els[mid].getBoundingClientRect().top <= top) { current = els[mid]; lo = mid + 1; } else hi = mid - 1; }
    var links = $('toc').querySelectorAll('.sec-link');
    links.forEach(function (a) { a.classList.toggle('active', !!current && a.dataset.id === current.id); });
    // 漏听索引也标阅读位置：可视区顶部第一句所在的（最内层）漏听段落
    var rc = readingCue(), rb = rc ? rc.closest('.loc-block') : null, rl = rb ? '#loc-' + rb.dataset.loc : null;
    $('loclist').querySelectorAll('a').forEach(function (a) { a.classList.toggle('active', a.getAttribute('href') === rl); });
    if (state.link.sp.b) { var panel = $('toc').classList.contains('active') ? $('toc') : $('loclist'), ra = panel.querySelector('a.active'); if (ra && ra.getAttribute('href') !== state.readAt) { state.readAt = ra.getAttribute('href'); revealInPanel(ra, panel); } }
  }
  window.addEventListener('scroll', function () {
    if (!spyTick) { spyTick = true; requestAnimationFrame(function () { spyTick = false; updateScrollSpy(); }); }
  }, { passive: true });

  // ---------- 音频 ----------
  var pendingSeek = null;
  function seek(t, play) {
    var m = mediaEl(); if (!Number.isFinite(t) || t < 0) return;
    if (!m.getAttribute('src') || m.readyState < 1) {
      pendingSeek = { element: m, time: t, play: !!play };
      if (m.getAttribute('src')) { if (play) m.play().catch(function () {}); else m.load(); }
      toast('正在准备音频，准备好后定位'); return;
    }
    pendingSeek = null; m.currentTime = Math.min(t, Number.isFinite(m.duration) ? Math.max(0, m.duration - .01) : t);
    onTimeUpdate(); if (play) m.play().catch(function () { toast('请点播放器开始播放'); });
  }
  function setLoop(p) {
    state.loop = p ? { start: p.startTime, end: p.endTime, label: p.label, cue: p.cue || null, para: p.para || null,
                       range: p.cues || p.para || (p.cue ? [p.cue, p.cue] : null) } : null;   // range：盲听「当前段可见」的范围随循环对象走
    // 顶栏因循环行出现 / 消失而变高变矮时，正文在屏幕上不能动：Chrome 的 scroll anchoring 通常已自动补偿（在布局时同步完成），
    // 这里量一个参照句的位置，只补偿残差，避免和浏览器各补一次变成双倍（2026-09-28 实测）
    var ref = document.querySelector('.cue.active') || readingCue(), top0 = ref ? ref.getBoundingClientRect().top : null;
    $('loop-row').classList.toggle('hidden', !p);
    if (ref) { var d = ref.getBoundingClientRect().top - top0; if (Math.abs(d) > 1 && window.scrollY > 0) { window.scrollBy(0, d); } }
    var was = document.querySelector('.cue.looping'); if (was) was.classList.remove('looping');
    document.querySelectorAll('.para.looping').forEach(function (e) { e.classList.remove('looping'); });
    if (p) {
      $('lr-label').textContent = p.label || fmt(p.startTime); $('lr-label').title = p.label || '';
      renderLoopTicks();
      if (p.cue) { var el = document.getElementById('cue-' + p.cue); if (el) el.classList.add('looping'); }
      if (p.para) document.querySelectorAll('.para[data-lo="' + p.para[0] + '"]').forEach(function (e) { e.classList.add('looping'); });
      seekKeep(p.startTime); updateLoopBar(p.startTime); rafLoopBar();
    }
    syncScrollPadding(); updateParaNow(); Touch.sync();
  }
  /** 小段循环：结构段落（说话人的一轮）；toggle 时再点同一段 = 停止 */
  function loopPara(lo, hi, toggle) {
    var a = state.cueById[lo], b = state.cueById[hi]; if (!a || !b) return;
    if (toggle && state.loop && state.loop.para && state.loop.para[0] === lo && state.loop.para[1] === hi) { setLoop(null); toast('已停止小段循环'); return; }
    var el = document.querySelector('.para[data-lo="' + lo + '"]'), spk = el ? (SPK_NAME[el.dataset.speaker] || el.dataset.speaker) : '';
    setLoop({ startTime: a.s, endTime: b.e, label: '小段 ' + (spk ? spk + ' · ' : '') + (hi - lo + 1) + ' 句 · ' + a.en, para: [lo, hi] });
  }
  /** 单句循环：任意 cue 都可以；toggle 时再点同一句 = 停止 */
  function loopCue(i, toggle) {
    var c = state.cueById[i]; if (!c) return;
    if (toggle && state.loop && state.loop.cue === i) { setLoop(null); toast('已停止单句循环'); return; }
    setLoop({ startTime: c.s, endTime: c.e, label: '第 ' + i + ' 句 · ' + c.en, cue: i });
  }
  function loopBars() { return [$('loop-bar'), $('t-loopbar')]; }
  function renderLoopTicks() {
    var L = state.loop, D = L.end - L.start, html = '';
    if (D > 0) {
      // 句 / 段分区：循环范围里的每一句一块（说话人色、交替深浅、关键句黄底、插话淡化），换一轮说话时画一道该说话人色的分界线
      var cs = L.range ? cuesIn(L.range) : state.cues.filter(function (c) { return c.e > L.start && c.s < L.end; });
      var prevLo = null, k = 0;
      cs.forEach(function (c) {
        var el = document.getElementById('cue-' + c.i), para = el ? el.closest('.para') : null, spk = para ? para.dataset.speaker : 'Unknown', lo = para ? para.dataset.lo : null;
        var l = Math.max(0, (c.s - L.start) / D), r = Math.min(1, (c.e - L.start) / D); if (r <= l) return;
        if (lo !== prevLo) { if (prevLo !== null) html += '<div class="lb-para spk-' + esc(spk) + '" style="left:' + (l * 100) + '%"></div>'; prevLo = lo; k = 0; }
        html += '<div class="lb-seg spk-' + esc(spk) + (k % 2 ? ' odd' : '') + (state.keyOwner[c.i] ? ' key' : '') + (state.asideOf[c.i] ? ' aside' : '') + '" style="left:' + (l * 100) + '%;width:' + ((r - l) * 100) + '%" title="' + esc(fmt(c.s) + ' · ' + (SPK_NAME[spk] || spk) + (state.keyOwner[c.i] ? ' · 关键句' : '') + (state.asideOf[c.i] ? ' · 插话' : '') + '\n' + c.en) + '"></div>';
        k++;
      });
      var step = D <= 60 ? 1 : D <= 300 ? 5 : 30;
      for (var s = step; s < D; s += step) html += '<div class="lb-tick" style="left:' + (s / D * 100) + '%"></div>';
    }
    loopBars().forEach(function (bar) { bar.innerHTML = html + '<div class="lb-fill"></div><div class="lb-head"></div>'; });
  }
  function updateLoopBar(t) {
    var L = state.loop; if (!L) return; var D = L.end - L.start, f = D > 0 ? Math.max(0, Math.min(1, (t - L.start) / D)) : 0;
    loopBars().forEach(function (bar) { var fill = bar.querySelector('.lb-fill'), head = bar.querySelector('.lb-head'); if (fill) fill.style.width = (f * 100) + '%'; if (head) head.style.left = (f * 100) + '%'; });
    var label = Math.max(0, t - L.start).toFixed(1) + 's / ' + D.toFixed(1) + 's · ' + fmt(L.start) + '–' + fmt(L.end);
    if ($('lr-time').textContent !== label) { $('lr-time').textContent = label; Touch.loopTime(label); }
  }
  var rafPending = false;
  function rafLoopBar() { if (rafPending) return; rafPending = true; requestAnimationFrame(function tick() { rafPending = false; var m = mediaEl(); if (!state.loop || m.paused) return; updateLoopBar(m.currentTime); rafPending = true; requestAnimationFrame(tick); }); }
  $('loop-stop').onclick = function () { setLoop(null); };
  (function () {
    var bar = $('loop-bar'), down = false;
    function at(e) { var L = state.loop; if (!L) return; var r = bar.getBoundingClientRect(), f = Math.max(0, Math.min(1, (e.clientX - r.left) / r.width)); var t = L.start + f * (L.end - L.start); localSeekGuard(); mediaEl().currentTime = t; updateLoopBar(t); }
    bar.addEventListener('pointerdown', function (e) { down = true; bar.setPointerCapture(e.pointerId); at(e); e.preventDefault(); });
    bar.addEventListener('pointermove', function (e) { if (down) at(e); });
    bar.addEventListener('pointerup', function (e) { if (!down) return; down = false; at(e); });
  })();
  function findCue(t) {
    var lo = 0, hi = state.cues.length - 1, best = -1;
    while (lo <= hi) { var mid = (lo + hi) >> 1; if (state.cues[mid].s <= t) { best = mid; lo = mid + 1; } else hi = mid - 1; }
    // 句间空隙也算上一句（直到下一句开始）：否则每个停顿都会让 activeCue 变 null，
    // 盲听「当前段可见」、侧栏「正在播放」标记和画面字幕都会在句子切换时闪一下
    if (best < 0) return null; return state.cues[best];
  }
  /** 逐句：d = -1 时，距本句起点超过 1 秒先回到本句起点，否则上一句；d = +1 下一句。保持播放 / 暂停状态 */
  function stepCue(d) {
