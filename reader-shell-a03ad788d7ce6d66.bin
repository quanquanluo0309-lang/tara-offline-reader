    for (var ci = 0; ci < ch.length; ci++) for (var si = 0; si < ch[ci].sections.length; si++) { var c = ch[ci].sections[si].cues; if (id >= c[0] && id <= c[1]) return 'sec-' + ci + '-' + si; }
    return null;
  }
  /** 侧栏「目录」跟随播放：当前所在节标 ▶，开着「跟随播放」时滚到可见（阅读位置的 .active 仍由滚动决定） */
  function updateTocNow() {
    if (state.activeCue === null) return;
    var sid = sectionAt(state.activeCue), toc = $('toc'), cur = toc.querySelector('.sec-link.now');
    if (cur && cur.dataset.id === sid) return;
    if (cur) cur.classList.remove('now');
    if (!sid) return;
    var a = toc.querySelector('.sec-link[data-id="' + sid + '"]'); if (!a) return; a.classList.add('now');
    if (state.link.ps.a && toc.classList.contains('active')) revealInPanel(a, toc);
  }
  /**
   * 把侧栏面板里的某一项滚到可见：不在面板可视区内时放到面板上三分之一处（后面的条目留在视野里）。
   * 不用 scrollIntoView：它只把条目贴到面板底边，且会连带滚动 window；面板在 sticky 的侧栏里，
   * 2026-09-28 用户反馈跟随时索引只高亮不滚动，改为手算 scrollTop，并在切 tab / 开跟随 / 显示侧栏 / 换句时补滚。
   */
  function revealInPanel(a, panel) {
