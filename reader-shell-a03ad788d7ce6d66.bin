  }
  /** 包含某句的漏听段落；嵌套重叠时取最内层（跨度最小） */
  function locAt(id) {
    if (id === null) return -1; var best = -1, span = Infinity;
    state.located.forEach(function (p, pi) { var w = p.cues[1] - p.cues[0]; if (id >= p.cues[0] && id <= p.cues[1] && w < span) { span = w; best = pi; } });
    return best;
  }
  /** 侧栏「漏听段落」索引跟随播放：当前所在段落高亮，开着「跟随播放」时滚到可见（时间序、大纲序都适用） */
  function updateLocNow() {
    if (state.activeCue === null) return;   // 同上：无当前句时不撤销
    var pi = locAt(state.activeCue), list = $('loclist'), cur = list.querySelector('a.now');
    if (cur && cur.getAttribute('href') === '#loc-' + pi) return;
    if (cur) cur.classList.remove('now');
    if (pi < 0) return;
    var a = list.querySelector('a[href="#loc-' + pi + '"]'); if (!a) return; a.classList.add('now');
    if (state.link.ps.a && list.classList.contains('active')) revealInPanel(a, list);
  }
  [audio, video].forEach(function (m) {
    m.addEventListener('timeupdate', onTimeUpdate);
    m.addEventListener('seeked', onTimeUpdate);
    m.addEventListener('play', rafLoopBar);
    m.addEventListener('error', function () { if (state.audioName && m === mediaEl()) toast('媒体未找到：' + state.audioName + '，请用「媒体」按钮手动打开'); });
    m.addEventListener('loadedmetadata', function () { if (pendingSeek && pendingSeek.element === m) { var intent = pendingSeek; pendingSeek = null; seek(intent.time, intent.play); } syncScrollPadding(); renderTimeline(); });
  });

  // ---------- 媒体源 / 倍速 / 画面 / 画面字幕 / 蒙版 ----------
  function setMediaSource(src, type, name) {
    state.mediaType = type; state.audioName = name; state.activeCue = null;
    if (type === 'video') { audio.removeAttribute('src'); video.src = src; document.body.classList.add('has-video'); }
    else { video.removeAttribute('src'); audio.src = src; document.body.classList.remove('has-video'); }
    setSpeed(state.speed); renderVideoSub(); requestAnimationFrame(syncScrollPadding);
  }
  var SPEEDS = [0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75, 2];   // 0.25 一档到 2（2026-09-28 用户）
  function syncSpeedMenu(sp) {
    if (!Array.from($('speed').options).some(function (o) { return +o.value === sp; })) { var option = new Option(sp + '×', String(sp)); $('speed').add(option); }
    $('speed').value = String(sp); Touch.sync();
  }
  function setSpeed(sp) { state.speed = sp; audio.defaultPlaybackRate = video.defaultPlaybackRate = sp; if (audio.playbackRate !== sp) audio.playbackRate = sp; if (video.playbackRate !== sp) video.playbackRate = sp; syncSpeedMenu(sp); savePrefs(); }
  [audio, video].forEach(function (m) { m.addEventListener('ratechange', function () { if (m === mediaEl()) { state.speed = m.playbackRate; if (m.defaultPlaybackRate !== state.speed) m.defaultPlaybackRate = state.speed; syncSpeedMenu(state.speed); savePrefs(); } }); });
  function stepSpeed(d) { var i = Math.max(0, Math.min(SPEEDS.length - 1, SPEEDS.indexOf(state.speed) + d)); setSpeed(SPEEDS[i]); toast('倍速 ' + SPEEDS[i] + '×'); }
  function applyVideoPrefs() {
    $('video-pane').className = 'video-pane size-' + state.videoSize;
    document.querySelectorAll('[data-vsize]').forEach(function (b) { b.classList.toggle('active', b.dataset.vsize === state.videoSize); });
    document.body.classList.toggle('video-hidden', state.videoHidden);
