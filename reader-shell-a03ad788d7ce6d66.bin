    var es = tg.closest('[data-editsave]'); if (es) { saveEdit(+es.dataset.editsave); return; }
    if (tg.closest('[data-editcancel]')) { var y0 = window.scrollY; render(); window.scrollTo(0, y0); return; }
    var dl = tg.closest('[data-del]'); if (dl) { deleteParagraph(+dl.dataset.del); return; }
    var at = tg.closest('[data-attach]'); if (at) { attachParagraph(+at.dataset.attach); return; }
