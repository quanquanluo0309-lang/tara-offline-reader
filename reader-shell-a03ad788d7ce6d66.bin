  $('video-sub-toggle').onclick = function () { state.videoSub = !state.videoSub; applyVideoPrefs(); savePrefs(); };
  $('mask-toggle').onclick = function () { state.mask.on = !state.mask.on; applyMask(); savePrefs(); };
  document.querySelectorAll('[data-vsize]').forEach(function (b) { b.onclick = function () { state.videoSize = b.dataset.vsize; applyVideoPrefs(); savePrefs(); }; });

  // ---------- 点击 ----------
  document.addEventListener('click', function (e) {
    var tg = e.target instanceof Element ? e.target : null; if (!tg) return;
    // 点过的按钮立刻失焦：否则焦点留在「播放 / 循环」上，之后按空格是再点一次那个按钮，而不是播放 / 暂停（2026-09-28 用户反馈）
