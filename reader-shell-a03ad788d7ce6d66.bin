  }
  // 四档显示模式；循环顺序即此表顺序。翻转按钮在「当前」与「上一次」之间来回，像电视的回看键。
  // 盲听不是第五档：它是独立开关（state.blind），开着时当前模式的字幕文字全部模糊，关掉即回到原模式
  var MODE_ORDER = ['off', 'cue', 'para', 'only'];
  var MODE_NAME = { off: '仅英文', cue: '英文+逐句中文', para: '英文+段末中文', only: '仅中文' };
