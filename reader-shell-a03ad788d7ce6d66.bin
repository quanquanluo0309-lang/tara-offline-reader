<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tara · 离线逐字稿</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #fbfaf7; --fg: #1f2328; --muted: #6b7280; --line: #e6e2d8; --hover: #f1eee6; --card: #ffffff;
    --accent: #2563eb; --btn-bg: #ffffff; --btn-line: #d1d5db;
    --loc-bg: #fdf1d4; --loc-line: #d97706; --loc-fg: #92400e;
    --key-bg: #fcd34d; --key-line: #b45309;
    --vocab-bg: #dbeafe; --vocab-line: #3b82f6;
    --colloc-bg: #dcfce7; --colloc-line: #16a34a;
    --q-bg: #fce7f3; --q-line: #db2777;
    --active-bg: #e0e7ff;
    --spk-lenny: #2563eb; --spk-tara: #7c3aed; --spk-ad: #9ca3af;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12131a; --fg: #e5e7eb; --muted: #9ca3af; --line: #2a2d3a; --hover: #1b1e2a; --card: #171922;
      --accent: #60a5fa; --btn-bg: #1b1e2a; --btn-line: #374151;
      --loc-bg: #2a2110; --loc-line: #f59e0b; --loc-fg: #fbbf24;
      --key-bg: #6b4c07; --key-line: #f59e0b;
      --vocab-bg: #1e3a8a; --vocab-line: #60a5fa;
      --colloc-bg: #14532d; --colloc-line: #4ade80;
      --q-bg: #831843; --q-line: #f472b6;
      --active-bg: #1e2a5a;
      --spk-lenny: #60a5fa; --spk-tara: #a78bfa; --spk-ad: #6b7280;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-padding-top: 130px; }  /* 初值；运行时按顶栏实际高度重算（顶栏会随视口宽度换行） */
  body { margin: 0; background: var(--bg); color: var(--fg);
         font: 16px/1.7 -apple-system, "PingFang SC", "Helvetica Neue", "Noto Sans CJK SC", Georgia, sans-serif; }
  header { position: sticky; top: 0; z-index: 5; background: var(--bg); border-bottom: 1px solid var(--line); padding: 3px 16px 3px; }
  .hdr-top { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: center; }
  header h1 { font-size: 14px; margin: 0 8px 0 0; white-space: nowrap; max-width: 40vw; overflow: hidden; text-overflow: ellipsis; }
  .stats { display: flex; gap: 8px 10px; font-size: 12px; color: var(--muted); flex-wrap: wrap; padding: 0 6px 6px; }
  .stats b { color: var(--fg); }
  /* 第二行：全部按钮组平铺（不收进菜单）；字号与内距压小，尽量一行放下 */
  .actions { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; justify-content: flex-end; margin-top: 2px; }
  .actions button, .actions label.btn { padding: 1px 6px; font-size: 11px; border-radius: 5px; }
  button, label.btn, select { font: inherit; font-size: 12px; padding: 3px 9px; border-radius: 6px; border: 1px solid var(--btn-line);
           background: var(--btn-bg); color: var(--fg); cursor: pointer; }
  button:hover, label.btn:hover { border-color: var(--accent); }
  button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  button.active { border-color: var(--accent); color: var(--accent); }
  input[type=file] { display: none; }
  .hdr-media { display: none; gap: 12px; align-items: flex-start; margin-top: 4px; flex-wrap: wrap; }
  body.has-video .hdr-media { display: flex; }
  .hdr-controls { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 200px; }
  .hdr-controls audio { flex: 1; max-width: 520px; height: 28px; }
  body.has-video .hdr-controls audio { display: none; }
  /* 视频画面：固定在顶栏里，三档宽度，可收起只听声音 */
  .video-pane { display: none; flex: none; }
  body.has-video .video-pane { display: block; }
  .video-wrap { position: relative; background: #000; border-radius: 8px; overflow: hidden; width: 440px; max-width: 100%; }
  .video-pane.size-s .video-wrap { width: 280px; }
  .video-pane.size-l .video-wrap { width: 640px; }
  .video-wrap video { display: block; width: 100%; }
  body.video-hidden .video-wrap { display: none; }
  .video-sub { position: absolute; left: 0; right: 0; bottom: 12%; z-index: 2; text-align: center; pointer-events: none; padding: 0 5%; color: #fff; text-shadow: 0 0 4px #000, 0 0 10px #000; }
  .video-sub .vs-en { font-size: 15px; line-height: 1.35; }
  .video-sub .vs-zh { font-size: 13px; line-height: 1.35; opacity: .92; }
  .mask { position: absolute; left: 0; right: 0; z-index: 3; background: #101010; opacity: .97; cursor: move; }
  .mask.hidden { display: none; }
  .mask-grip { position: absolute; left: 0; right: 0; bottom: 0; height: 8px; cursor: ns-resize; background: rgba(255,255,255,.18); }
  .video-tools { display: flex; gap: 4px; margin-top: 4px; flex-wrap: wrap; }
  .video-tools button { padding: 1px 7px; font-size: 11px; }
  .sep { width: 1px; height: 18px; background: var(--line); margin: 0 3px; }
  /* 分组框与常驻按钮同一行平铺（宽屏一行放下，窄屏自动换行） */
  .group { display: inline-flex; align-items: center; gap: 3px; padding: 2px 4px 2px 3px; border: 1px solid var(--line); border-radius: 6px; background: var(--hover); }
  .grp-label { font-size: 10px; color: var(--muted); padding: 0 5px 0 3px; border-right: 1px solid var(--line); margin-right: 2px; white-space: nowrap; }
  /* 时间线：段落色块（上半）+ 关键句色块（下半）+ 播放头，点击跳转 */
  .timeline { position: relative; height: 12px; margin: 8px 0 2px; background: var(--hover); border-radius: 6px; cursor: pointer; overflow: hidden; }
  .timeline .tl-p { position: absolute; top: 0; height: 50%; background: var(--loc-line); opacity: .55; }
  .timeline .tl-s { position: absolute; bottom: 0; height: 50%; background: var(--key-line); opacity: .8; }
  .timeline .tl-head { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--accent); pointer-events: none; }
  /* 选句模式 */
  body.selecting .cue .en, body.selecting .cue .zh { cursor: cell; }
  .cue.sel .en, .cue.sel .zh, .zh-para .zhc.sel { background: var(--active-bg); outline: 1px dashed var(--accent); border-radius: 3px; }
  .selbar { position: fixed; left: 50%; bottom: 18px; transform: translateX(-50%); z-index: 25; display: none; gap: 8px; align-items: center;
            background: var(--card); border: 1px solid var(--accent); border-radius: 10px; padding: 8px 12px; box-shadow: 0 6px 24px rgba(0,0,0,.18); font-size: 13px; }
  .selbar.show { display: flex; }
  /* 段落标题栏内的编辑表单 */
  .loc-edit { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; width: 100%; }
  .loc-edit input { font: inherit; font-size: 12px; padding: 2px 6px; border-radius: 6px; border: 1px solid var(--btn-line); background: var(--bg); color: var(--fg); }
  .loc-edit input.lbl { flex: 1; min-width: 160px; }
  .loc-edit input.tm { width: 80px; font-family: ui-monospace, Menlo, monospace; }
  .loc-head .ops { margin-left: auto; display: flex; gap: 4px; }
  .loc-head .ops button { padding: 0 6px; }
  /* 循环行：单句 / 关键句 / 漏听段落循环时出现，进度条以循环区间为起止 */
  .loop-row { display: flex; align-items: center; gap: 8px; margin-top: 3px; font-size: 12px; color: var(--loc-fg); }
  .loop-row.hidden { display: none; }
  .loop-row .lr-label { white-space: nowrap; max-width: 38vw; overflow: hidden; text-overflow: ellipsis; }
  .loop-row .lr-time { font: 11px/1 ui-monospace, Menlo, monospace; color: var(--muted); white-space: nowrap; }
  .loop-row button { padding: 1px 6px; font-size: 11px; }
  .loop-bar { flex: 1; height: 18px; position: relative; background: var(--hover); border: 1px solid var(--line); border-radius: 8px; cursor: pointer; touch-action: none; overflow: hidden; }
  .loop-bar .lb-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: color-mix(in srgb, var(--accent) 22%, transparent); pointer-events: none; z-index: 2; }
  .loop-bar .lb-head { position: absolute; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: var(--accent); pointer-events: none; z-index: 3; }
  .loop-bar .lb-tick { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--line); pointer-events: none; z-index: 1; }
  /* 循环区间内的句 / 段分区：按说话人着色、句与句交替深浅、关键句黄底、插话淡化、段落（说话人的一轮）边界一道色线（2026-09-28 用户） */
  .loop-bar .lb-seg { position: absolute; top: 0; bottom: 0; z-index: 0; }
  .loop-bar .lb-seg.spk-Lenny { background: color-mix(in srgb, var(--spk-lenny) 20%, transparent); }
  .loop-bar .lb-seg.spk-Tara { background: color-mix(in srgb, var(--spk-tara) 20%, transparent); }
  .loop-bar .lb-seg.spk-Ad, .loop-bar .lb-seg.spk-Unknown { background: color-mix(in srgb, var(--spk-ad) 20%, transparent); }
  .loop-bar .lb-seg.odd::after { content: ''; position: absolute; inset: 0; background: rgba(0, 0, 0, .07); }
  .loop-bar .lb-seg.key { background: var(--key-bg); box-shadow: inset 0 -3px 0 var(--key-line); }
  .loop-bar .lb-seg.aside { opacity: .45; }
  .loop-bar .lb-para { position: absolute; top: 0; bottom: 0; width: 2px; margin-left: -1px; pointer-events: none; z-index: 1; }
  .loop-bar .lb-para.spk-Lenny { background: var(--spk-lenny); }
  .loop-bar .lb-para.spk-Tara { background: var(--spk-tara); }
  .loop-bar .lb-para.spk-Ad, .loop-bar .lb-para.spk-Unknown { background: var(--spk-ad); }
  .cue .cue-loop { font-size: 11px; cursor: pointer; margin-right: 4px; opacity: 0; transition: opacity .15s; user-select: none; }
  .cue:hover .cue-loop, .cue.looping .cue-loop { opacity: 1; }
  .cue.looping .cue-loop { filter: drop-shadow(0 0 2px var(--accent)); }
  /* 小段循环：结构段落（说话人的一轮）级别，介于整个漏听段落与单句之间 */
  .para { position: relative; }
  .para .para-loop { position: absolute; left: -22px; top: 2px; font-size: 11px; cursor: pointer; opacity: 0; transition: opacity .15s; user-select: none; }
  .para:hover .para-loop, .para.looping .para-loop { opacity: 1; }
  .para.looping { border-left-color: var(--accent) !important; }
  .para.looping .para-loop { filter: drop-shadow(0 0 2px var(--accent)); }

  .layout { display: flex; max-width: 1280px; margin: 0 auto; }
  nav#side { width: 312px; flex: none; position: sticky; top: calc(var(--hdr, 104px) + 8px); align-self: flex-start; height: calc(100vh - var(--hdr, 104px) - 16px);
             display: flex; flex-direction: column; padding: 10px 30px 0 16px; font-size: 13px; }   /* 右侧 30px 留给分隔边上的竖排开关 */
  body.side-hidden nav#side { display: none; }
  .tabs { display: flex; gap: 4px; margin-bottom: 6px; }
  .tabs button { flex: 1; padding: 4px 6px; }
  .tabs button.active { background: var(--active-bg); }
  .panel { display: none; overflow-y: auto; flex: 1; padding-bottom: 40px; }
  .panel.active { display: block; }
  #toc .ch { margin: 8px 0 2px; }
  #toc .ch > a { display: block; font-weight: 600; color: var(--fg); text-decoration: none; padding: 3px 6px; border-radius: 4px; }
  #toc .ch > a .t, #toc .sec-link .t { color: var(--muted); font-size: 11px; margin-left: 4px; font-weight: 400; }
  #toc a, #loclist a { user-select: none; }
  #toc .sec-link { display: block; color: var(--muted); text-decoration: none; padding: 2px 6px 2px 14px; border-left: 2px solid var(--line); margin-left: 8px; border-radius: 0 4px 4px 0; }
  #toc a:hover { background: var(--hover); }
  #toc .sec-link.active { color: var(--accent); border-left-color: var(--accent); background: var(--active-bg); }
  /* .active = 阅读位置（随滚动）；.now = 播放位置（随媒体）。跟随播放开着时两者重合 */
  #toc .sec-link.now { border-left-color: var(--accent); color: var(--fg); font-weight: 600; }
  #toc .sec-link.now::before, #loclist a.now::before { content: '▶ '; color: var(--accent); font-size: 10px; }
  #toc .sec-link.kind-ad, #toc .sec-link.kind-banter, #toc .sec-link.kind-outro { color: var(--muted); opacity: .7; font-size: 12px; }
  #loclist a { display: block; color: var(--fg); text-decoration: none; padding: 3px 6px; border-radius: 4px; border-left: 3px solid var(--loc-line); margin-bottom: 3px; }
  #loclist a:hover, #loclist a.active { background: var(--hover); }   /* .active = 阅读位置（随滚动）；.now = 播放位置 */
  #toc a.picked, #loclist a.picked { outline: 1px dashed var(--accent); outline-offset: -1px; }   /* 单击选中的条目 */
  button.both { background: var(--active-bg); }
  #loclist a.now { background: var(--active-bg); border-left-color: var(--accent); }
  #loclist a.now b { color: var(--accent); }
  #loclist a .t { color: var(--muted); font-size: 11px; margin-left: 4px; }
  #loclist .hint, #toc .hint { color: var(--muted); font-size: 12px; padding: 4px 6px; }
  .loc-sort { display: flex; gap: 4px; margin: 0 6px 4px; }
  .loc-sort button { flex: 1; padding: 2px 6px; font-size: 12px; }
  .loc-sort button.active { background: var(--active-bg); border-color: var(--accent); color: var(--accent); }

  .main-col { flex: 1; min-width: 0; max-width: 840px; }
  main { padding: 18px 28px 140px; }
  /* 三个跟随开关放在各自作用的位置（2026-09-28 用户指定）：侧栏顶「播放 → 侧栏」、正文顶「播放 → 正文」、侧栏与正文的分隔边竖排「侧栏 → 正文」 */
  .main-tools { position: sticky; top: calc(var(--hdr, 104px) + 6px); height: 0; z-index: 4; display: flex; justify-content: flex-end; align-items: flex-start; padding: 0 28px; pointer-events: none; }
  .main-tools button, .side-tools button { pointer-events: auto; padding: 1px 8px; font-size: 11px; border-radius: 10px; background: var(--bg); box-shadow: 0 1px 3px rgba(0,0,0,.12); }
  .main-tools button { margin-top: 2px; }
  .side-tools { display: flex; justify-content: flex-start; margin: -4px 0 6px; }
  nav#side .edge-tab .hz { writing-mode: horizontal-tb; display: inline-block; line-height: 1; margin: 2px 0; }
  nav#side .edge-tab { position: absolute; right: 0; top: 40%; writing-mode: vertical-rl; text-orientation: upright; letter-spacing: .1em; padding: 8px 1px; font-size: 11px; line-height: 1.2; border-radius: 0 6px 6px 0; background: var(--bg); box-shadow: 0 1px 3px rgba(0,0,0,.12); }
  .empty { border: 2px dashed var(--line); border-radius: 12px; padding: 48px 24px; text-align: center; color: var(--muted); }
  .legend { font-size: 12px; color: var(--muted); margin: 0 0 18px; display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .legend span { padding: 0 6px; border-radius: 3px; }
  .legend.legend-bars { margin-top: -12px; }
  .legend .bar-sample { border-left: 3px solid var(--line); padding-left: 6px; border-radius: 0; }
  .legend .bar-sample[data-speaker="Lenny"] { border-left-color: var(--spk-lenny); }
  .legend .bar-sample[data-speaker="Tara"] { border-left-color: var(--spk-tara); }
  .legend .bar-sample[data-speaker="Ad"] { border-left-color: var(--spk-ad); }

  h2.ch-title { font-size: 20px; margin: 34px 0 8px; padding-bottom: 6px; border-bottom: 2px solid var(--line); }
  h2.ch-title .num { color: var(--muted); font-weight: 500; margin-right: 8px; }
  h2.ch-title .t, h3.sec-title .t { color: var(--muted); font-size: 12px; font-weight: 400; margin-left: 8px; }
  h3.sec-title { font-size: 15px; margin: 22px 0 8px; color: var(--fg); }
  section.sec.kind-ad h3, section.sec.kind-banter h3, section.sec.kind-outro h3, section.sec.kind-intro h3 { color: var(--muted); font-weight: 500; }
  section.sec.folded .sec-body { display: none; }
  section.sec .fold { font-size: 11px; color: var(--muted); margin-left: 8px; cursor: pointer; border: 1px solid var(--btn-line); border-radius: 4px; padding: 0 6px; }
  section.sec .fold:hover { color: var(--accent); }

  .para { margin: 0 0 12px; padding-left: 10px; border-left: 3px solid transparent; }
  .para[data-speaker="Lenny"] { border-left-color: var(--spk-lenny); }
  .para[data-speaker="Tara"] { border-left-color: var(--spk-tara); }
  .para[data-speaker="Ad"] { border-left-color: var(--spk-ad); }
  .para .text { margin: 0; }
  .spk { display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: .02em; padding: 0 6px; border-radius: 4px; margin-right: 6px; vertical-align: 2px; }
  .spk-Lenny { color: var(--spk-lenny); background: color-mix(in srgb, var(--spk-lenny) 12%, transparent); }
  .spk-Tara { color: var(--spk-tara); background: color-mix(in srgb, var(--spk-tara) 12%, transparent); }
  .spk-Ad, .spk-Unknown { color: var(--muted); background: var(--hover); }
  /* 插话：另一说话人的短应答（Yes. / Yeah. / Mm-hmm.）不单独成段，内联在前一段里，小号说话人标签 + 灰字 */
  .spk.mini { font-size: 10px; padding: 0 4px; margin: 0 3px 0 2px; vertical-align: 1px; }
  .cue.aside .en, .cue.aside .zh, .zh-para .zhc.aside { color: var(--muted); }

  .cue { position: relative; }
  .cue .ts { font: 11px/1 ui-monospace, Menlo, monospace; color: var(--muted); text-decoration: none; cursor: pointer; margin-right: 4px;
             opacity: 0; transition: opacity .15s; user-select: none; }
  .cue:hover .ts, .cue.first .ts, .cue.active .ts { opacity: 1; }
  .cue .ts:hover { color: var(--accent); }
  .cue .en { border-radius: 3px; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .cue.key .en, .cue.key .zh, .zh-para .zhc.key { background: var(--key-bg); border-bottom: 2px solid var(--key-line); padding: 1px 2px; border-radius: 3px; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .cue.active .en, .cue.active .zh, .zh-para .zhc.active { background: var(--active-bg); border-radius: 3px; }
  .cue.key.active .en, .cue.key.active .zh, .zh-para .zhc.key.active { outline: 2px solid var(--accent); }
  .cue .zh { display: none; color: var(--muted); font-size: 14px; margin: 0 0 6px 20px; }
  body.show-zh-cue .cue .zh { display: block; }
  .zh-para { display: none; color: var(--muted); font-size: 14px; margin: 4px 0 0; padding-top: 4px; border-top: 1px dashed var(--line); }
  body.show-zh-para .zh-para { display: block; }
  /* 仅中文：英文句隐藏，中文句内联为正文（时间戳、关键句标签、区块结构照常） */
  body.show-zh-only .cue .en { display: none; }
  body.show-zh-only .cue .zh { display: inline; font-size: 16px; color: var(--fg); margin: 0; }
  /* 盲听：独立开关，与显示模式正交——当前模式下所有字幕文字模糊，版式、区块底色、关键句与跟随高亮保留，悬停单句可偷看 */
  body.show-blind .cue .en, body.show-blind .cue .zh, body.show-blind .zh-para .zhc { filter: blur(6px); user-select: none; }
  /* 悬停偷看是独立开关（show-blind-peek）；关掉就是完全盲听 */
  body:not(.touch-reader).show-blind.show-blind-peek .cue:hover .en, body:not(.touch-reader).show-blind.show-blind-peek .cue:hover .zh, body:not(.touch-reader).show-blind.show-blind-peek .zh-para .zhc:hover,
  body:not(.touch-reader).show-blind.show-blind-peek .cue.peek .en, body:not(.touch-reader).show-blind.show-blind-peek .cue.peek .zh { filter: none; }
  /* 悬停看清的那一句恢复可选中：盲听 + 悬停可见时照样能划词做词句标注；完全盲听时不能 */
  body:not(.touch-reader).show-blind.show-blind-peek .cue:hover .en, body:not(.touch-reader).show-blind.show-blind-peek .cue.peek .en { user-select: text; }
  #blind-peek:disabled, #blind-para:disabled { opacity: .45; cursor: default; }
  /* 仅当前段可见（show-blind-para）：范围 = 正在循环的对象（漏听段落 / 关键句 / 小段 / 单句），不循环时 = 正在播放的说话人一轮；范围内的句子标 .vis */
  body.show-blind.show-blind-para .cue.vis .en, body.show-blind.show-blind-para .cue.vis .zh, body.show-blind.show-blind-para .zh-para .zhc.vis { filter: none; }
  body.show-blind.show-blind-para .cue.vis .en { user-select: text; }
  /* 两个显示模式按钮定宽（运行时按最长标签量出），切换时不会因标签变长而挪位，可以在同一位置连点 */
  #zh-cycle, #zh-flip { text-align: center; }
  .speed-menu { display: inline-flex; align-items: center; gap: 6px; }

  /* 漏听段落 = 块级区块（容器）：标题栏 + 若干结构段落（说话人的一轮，各带说话人色条）+ 结束线；
     只有与别的段落部分重叠或跨节时才切成多块，后续块显示「续」 */
  .loc-block { margin: 6px 0 12px -10px; padding: 6px 12px 6px 12px; border-left: 4px solid var(--loc-line); background: var(--loc-bg); border-radius: 0 8px 8px 0; }
  .loc-block > .para { margin: 0 0 8px; }
  /* 「续」块紧接上一块：去掉块间空隙、上角不圆，读成同一段落的延续 */
  .loc-block + .loc-block.continued { margin-top: -8px; border-top-right-radius: 0; }
  .loc-block > .para:last-child, .loc-block > .para:has(+ .loc-end) { margin-bottom: 0; }
  .loc-block .para .para-loop { left: -16px; }
  /* 嵌套的漏听段落（完全落在外层段落里，或两段部分重叠的那几句）：同样米黄底，用虚线框 + 标题栏「与 #N 重叠」说明 */
  .loc-block .loc-block { margin: 4px 0 8px 0; border: 1px dashed var(--loc-line); border-left: 4px solid var(--key-line); background: var(--loc-bg); }
  .loc-head { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-size: 12px; color: var(--loc-fg); margin: 0 0 6px; padding-bottom: 4px; border-bottom: 1px dashed var(--loc-line); scroll-margin-top: 8px; }  /* html 已有 scroll-padding-top 让出顶栏，这里只留一点呼吸空间 */
  .loc-head .loc-num { font-weight: 700; background: var(--loc-line); color: #fff; border-radius: 4px; padding: 0 6px; }
  .loc-head .loc-label { font-weight: 600; color: var(--fg); }
  .loc-head .t { color: var(--muted); }
  .loc-head button { padding: 0 7px; font-size: 11px; line-height: 1.6; }
  .loc-cont { font-size: 11px; color: var(--loc-fg); opacity: .85; margin: 0 0 4px; }
  .loc-end { font-size: 11px; color: var(--muted); margin-top: 4px; text-align: right; }
  .key-tag { cursor: pointer; display: inline-block; font-size: 10px; line-height: 1.5; background: var(--key-line); color: #fff; border-radius: 3px; padding: 0 4px; margin-right: 4px; vertical-align: 2px; }
  .zh-para .zhc { margin-right: 4px; }

  mark.hl { padding: 0 1px; border-radius: 3px; cursor: pointer; color: inherit; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  mark.hl-vocab { background: var(--vocab-bg); border-bottom: 2px solid var(--vocab-line); }
  mark.hl-collocation { background: var(--colloc-bg); border-bottom: 2px solid var(--colloc-line); }
  mark.hl-question { background: var(--q-bg); border-bottom: 2px dotted var(--q-line); }
  mark.hl.has-note::after { content: " ✎"; font-size: 11px; color: var(--muted); }
  .popover { position: fixed; z-index: 20; display: none; background: var(--card); border: 1px solid var(--line); border-radius: 8px;
             box-shadow: 0 6px 24px rgba(0,0,0,.15); padding: 8px; font-size: 13px; min-width: 240px; max-width: 360px; }
  .popover.show { display: block; }
  .popover .row { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .popover .sel { color: var(--muted); font-size: 12px; margin-bottom: 6px; max-height: 60px; overflow: hidden; }
  .popover .b-vocab { border-color: var(--vocab-line); } .popover .b-colloc { border-color: var(--colloc-line); } .popover .b-q { border-color: var(--q-line); }
  .popover input { width: 100%; margin-top: 6px; font: inherit; font-size: 13px; padding: 4px 8px; border-radius: 6px; border: 1px solid var(--btn-line); background: var(--bg); color: var(--fg); }
  .popover .del { color: #b91c1c; }
  .toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: var(--fg); color: var(--bg);
           padding: 8px 14px; border-radius: 8px; font-size: 13px; opacity: 0; transition: opacity .2s; pointer-events: none; z-index: 30; }
  .toast.show { opacity: .95; }
  body.dragging::after { content: "释放以加载 字幕 / 结构 / 标记 / 音频或视频 / 标注 文件"; position: fixed; inset: 0; display: flex; align-items: center;
           justify-content: center; background: rgba(37,99,235,.12); border: 3px dashed var(--accent); font-size: 20px; color: var(--accent); z-index: 40; }
</style>
<style id="touch-shell">
/* ===== 触屏壳（手机 / 平板）：独立的顶栏、底栏、抽屉、情境条、菜单；只在触屏媒体查询下显示，桌面不受影响 ===== */
.reading-guide summary { display: none; }
.t-top, #t-bar, #t-pill, #t-ctx, #t-pop, #t-scrim, #t-drawer-foot { display: none; }
@media (max-width: 760px), (hover: none) and (pointer: coarse) {
  html { -webkit-text-size-adjust: 100%; }
  body { overflow-wrap: anywhere; }
  /* 顶栏：只有一行 44px（目录 · 标题 · 标注 · 更多）；桌面顶栏各行全部隐藏，高度不再随循环变化 */
  header { padding: env(safe-area-inset-top) 0 0; }
  header .hdr-top, header .actions, header #loop-row, header #timeline { display: none !important; }
  .t-top { display: flex; align-items: center; height: 44px; padding: 0 4px; gap: 2px; }
  .t-top button { height: 44px; min-width: 44px; padding: 0 10px; border: 0; background: transparent; font-size: 14px; border-radius: 10px; color: var(--fg); }
  .t-top button.active { color: var(--accent); background: var(--active-bg); font-weight: 600; }
  .t-top svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; pointer-events: none; }
  #t-title { flex: 1; min-width: 0; font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 4px; }
  /* 视频画面：顶栏下方整宽，可在「更多」里收起 */
  .hdr-media { margin: 0; padding: 0 8px 6px; }
  .video-pane, .video-pane.size-s, .video-pane.size-m, .video-pane.size-l { width: 100%; }
  .video-pane .video-wrap, .video-pane.size-s .video-wrap, .video-pane.size-m .video-wrap, .video-pane.size-l .video-wrap { width: 100%; }
  .video-tools { display: none; }
  /* 正文：整宽；底部留出底栏高度；行内不再有按钮 */
  .layout { display: block; }
  .main-col { max-width: none; }
  main { padding: 8px max(14px, env(safe-area-inset-right)) calc(var(--tbar, 96px) + 32px) max(14px, env(safe-area-inset-left)); touch-action: manipulation; }
  .main-tools { display: none; }
  .en, .zh, .zh-para { font-size: 17px; line-height: 1.75; }
  .zh-para { font-size: 15px; }
  .cue .ts, .cue .cue-loop, .para .para-loop { display: none; }
  .cue.first .ts { display: inline; opacity: 1; font-size: 11px; margin-right: 6px; }
  .loc-head button { display: none; }
  .loc-head { cursor: pointer; }
  .loc-head::after { content: '›'; margin-left: auto; color: var(--muted); font-size: 16px; line-height: 1; }
  body.touch-reader #main { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent; }
  .cue.pressing .en, .zhc.pressing { background: var(--hover); border-radius: 3px; }
  /* 遮盖：轻点揭开的句子 */
  body.touch-reader.show-blind .cue.revealed .en, body.touch-reader.show-blind .cue.revealed .zh, body.touch-reader.show-blind .zhc.revealed { filter: none; }
  /* 标注态：选词中的词、仅中文时临时露出英文 */
  mark.picking { background: color-mix(in srgb, var(--accent) 26%, transparent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 26%, transparent); border-radius: 3px; color: inherit; }
  body.annotating.show-zh-only .cue .en { display: inline; }
  body.annotating.show-zh-only .cue .zh { display: inline; }
  /* 两点圈选中的句子 */
  .cue.in-range .en, .cue.in-range .zh, .zhc.in-range { background: var(--active-bg); box-shadow: 0 0 0 2px var(--active-bg); border-radius: 3px; }
  /* 目录抽屉：左侧全高 */
  nav#side, body.side-hidden nav#side { display: none; }
  body.t-drawer-open nav#side { display: flex; position: fixed; z-index: 40; top: 0; left: 0; bottom: 0; width: min(86vw, 360px); height: 100dvh; max-height: 100dvh; padding: calc(env(safe-area-inset-top) + 10px) 14px calc(env(safe-area-inset-bottom) + 8px) max(14px, env(safe-area-inset-left)); background: var(--bg); box-shadow: 8px 0 24px #0003; }
  body.t-drawer-open #t-scrim { display: block; position: fixed; z-index: 39; inset: 0; background: #0006; }
  nav#side .side-tools, nav#side .edge-tab { display: none; }
  nav#side .panel { min-height: 0; }
  #t-drawer-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 0 0; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
  #toc a, #toc .sec-link, #loclist a { padding-top: 9px; padding-bottom: 9px; font-size: 14px; }
  .tabs button, .loc-sort button { min-height: 40px; font-size: 14px; }
  /* 底栏：进度行 + 按键行，固定在拇指区 */
  #t-bar { display: block; position: fixed; z-index: 35; left: 0; right: 0; bottom: 0; background: var(--bg); border-top: 1px solid var(--line); padding: 2px max(8px, env(safe-area-inset-right)) max(6px, env(safe-area-inset-bottom)) max(8px, env(safe-area-inset-left)); }
  #t-loopinfo { display: flex; gap: 8px; align-items: center; font-size: 12px; color: var(--loc-fg); padding: 4px 6px 0; }
  #t-loopinfo[hidden] { display: none; }
  #t-loopinfo .l { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #t-loopinfo .tm { font: 11px/1 ui-monospace, Menlo, monospace; color: var(--muted); white-space: nowrap; }
  #t-loopinfo button { min-height: 32px; padding: 0 10px; font-size: 12px; }
  .t-progress { display: flex; align-items: center; gap: 8px; height: 30px; font: 11px/1 ui-monospace, Menlo, monospace; color: var(--muted); font-variant-numeric: tabular-nums; }
  .t-track { position: relative; flex: 1; height: 30px; }
  #t-marks { position: absolute; left: 0; right: 0; top: 13px; height: 4px; border-radius: 2px; background: var(--line); overflow: hidden; }
  #t-marks i { position: absolute; top: 0; bottom: 0; background: var(--loc-line); opacity: .55; }
  #t-marks b { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: var(--accent); }
  #t-marks[hidden] { display: none; }
  #t-loopbar { position: absolute; left: 0; right: 0; top: 4px; height: 22px; border-radius: 6px; }
  #t-loopbar[hidden] { display: none; }
  #t-seek { position: absolute; left: 0; top: 0; width: 100%; height: 30px; margin: 0; padding: 0; -webkit-appearance: none; appearance: none; background: transparent; touch-action: pan-y; }
  #t-seek:disabled { opacity: .5; }
  #t-seek::-webkit-slider-runnable-track { height: 30px; background: transparent; }
  #t-seek::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; margin-top: 6px; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg); box-shadow: 0 1px 3px #0005; }
  #t-seek::-moz-range-track { height: 30px; background: transparent; }
  #t-seek::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg); }
  .t-keys { display: flex; align-items: center; justify-content: space-between; height: 50px; }
  .t-keys button { flex: 1; height: 50px; border: 0; background: transparent; border-radius: 12px; padding: 0; color: var(--fg); font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .t-keys button.active { color: var(--accent); }
  .t-keys button:disabled { opacity: .4; }
  .t-keys svg { width: 26px; height: 26px; fill: currentColor; pointer-events: none; }
  #t-play svg { width: 34px; height: 34px; }
  #t-play .pause-shape, #t-play.is-playing .play-shape { display: none; }
  #t-play.is-playing .pause-shape { display: block; }
  #t-mode.covered::after { content: '遮'; font-size: 10px; margin-left: 2px; padding: 0 3px; border-radius: 3px; background: var(--fg); color: var(--bg); vertical-align: 2px; }
  #t-loop.active svg { filter: drop-shadow(0 0 2px var(--accent)); }
  /* 情境条：圈选 / 选词二选一，贴在底栏上方 */
  #t-ctx { position: fixed; z-index: 36; left: 8px; right: 8px; bottom: calc(var(--tbar, 96px) + 8px); display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 8px 10px; border: 1px solid var(--accent); border-radius: 12px; background: var(--card); box-shadow: 0 4px 16px #0003; font-size: 13px; }
  #t-ctx[hidden] { display: none; }
  #t-ctx .txt { flex-basis: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #t-ctx .txt b { color: var(--accent); }
  #t-ctx button { min-height: 40px; font-size: 14px; flex: 1 0 auto; }
  #t-ctx button.b-vocab { border-color: var(--vocab-line); } #t-ctx button.b-colloc { border-color: var(--colloc-line); } #t-ctx button.b-q { border-color: var(--q-line); }
  /* 跟随被打断时的「回到当前句」 */
  #t-pill { position: fixed; z-index: 34; right: 14px; bottom: calc(var(--tbar, 96px) + 14px); display: inline-flex; align-items: center; gap: 4px; height: 36px; padding: 0 12px; border-radius: 18px; border: 1px solid var(--accent); background: var(--card); color: var(--accent); font-size: 13px; box-shadow: 0 2px 10px #0003; }
  #t-pill[hidden] { display: none; }
  /* 锚定在底栏上方的小面板（显示 / 遮盖、倍速） */
  #t-pop { position: fixed; z-index: 37; left: 8px; right: 8px; bottom: calc(var(--tbar, 96px) + 8px); display: block; padding: 12px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); box-shadow: 0 6px 24px #0004; }
  #t-pop[hidden] { display: none; }
  .seg { display: flex; border: 1px solid var(--btn-line); border-radius: 10px; overflow: hidden; background: var(--bg); }
  .seg button { flex: 1; min-height: 40px; border: 0; border-radius: 0; background: transparent; font-size: 14px; padding: 0 4px; white-space: nowrap; }
  .seg button + button { border-left: 1px solid var(--btn-line); }
  .seg button.active { background: var(--active-bg); color: var(--accent); font-weight: 600; }
  .seg button:disabled { opacity: .4; }
  .t-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 10px; font-size: 14px; }
  .t-row .seg { flex: 0 0 auto; min-width: 128px; }
  .t-row .seg button { min-height: 34px; font-size: 13px; }
  .t-row .mini { min-height: 34px; font-size: 13px; padding: 0 10px; }
  .t-row .hint { color: var(--muted); font-size: 12px; }
  .sw { position: relative; width: 48px; height: 28px; border-radius: 14px; background: var(--btn-line); border: 0; padding: 0; flex: none; transition: background .15s; }
  .sw::after { content: ''; position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%; background: #fff; transition: left .15s; box-shadow: 0 1px 2px #0004; }
  .sw[aria-checked="true"] { background: var(--accent); }
  .sw[aria-checked="true"]::after { left: 23px; }
  #t-pop input[type=range] { width: 100%; height: 40px; accent-color: var(--accent); margin: 6px 0 0; }
  #t-pop .ends { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); }
  #t-pop .head { display: flex; justify-content: space-between; align-items: center; font-size: 14px; }
  #t-pop .head output { font-weight: 600; color: var(--accent); }
  /* 底部菜单 / 表单（一个 dialog 复用） */
  #t-sheet { width: min(560px, 100%); max-width: 100%; max-height: 84dvh; margin: auto auto 0; padding: 10px 12px max(14px, env(safe-area-inset-bottom)); border: 0; border-radius: 18px 18px 0 0; background: var(--bg); color: var(--fg); overflow: auto; overscroll-behavior: contain; }
  #t-sheet::backdrop { background: #0006; }
  #t-sheet h3 { font-size: 13px; color: var(--muted); font-weight: 500; margin: 6px 4px 8px; line-height: 1.4; }
  #t-sheet .items { display: grid; gap: 6px; }
  #t-sheet .items button { text-align: left; min-height: 48px; font-size: 16px; padding: 10px 14px; border-radius: 12px; background: var(--card); }
  #t-sheet .items button small { display: block; font-size: 12px; color: var(--muted); font-weight: 400; }
  #t-sheet .items button.del { color: #b91c1c; }
  #t-sheet .items button.active { border-color: var(--accent); color: var(--accent); }
  #t-sheet .cancel { width: 100%; min-height: 48px; margin-top: 10px; font-size: 16px; border-radius: 12px; }
  #t-sheet label { display: grid; gap: 4px; font-size: 13px; color: var(--muted); margin: 8px 0; }
  #t-sheet input, #t-sheet select { min-height: 44px; font: inherit; font-size: 16px; padding: 6px 10px; border: 1px solid var(--btn-line); border-radius: 10px; background: var(--card); color: var(--fg); width: 100%; }
  #t-sheet .two { display: flex; gap: 8px; } #t-sheet .two label { flex: 1; }
  #t-sheet .row { display: flex; gap: 8px; margin-top: 10px; }
  #t-sheet .row button { flex: 1; min-height: 46px; font-size: 15px; border-radius: 12px; }
  #t-sheet p { margin: 4px 4px 8px; font-size: 14px; line-height: 1.6; }
  #t-sheet p.q { font-size: 16px; color: var(--fg); }
  #t-sheet .grp { font-size: 12px; color: var(--muted); margin: 14px 4px 4px; }
  #t-sheet .about { font-size: 13px; color: var(--muted); line-height: 1.7; margin: 4px; }
  .toast { bottom: calc(var(--tbar, 96px) + 16px); max-width: calc(100vw - 24px); width: max-content; }
  .popover, .selbar { display: none !important; }
  .reading-guide summary { display: list-item; min-height: 40px; padding: 6px 0; font-size: 13px; color: var(--muted); cursor: pointer; }
  .reading-guide + .chapter h2.ch-title { margin-top: 14px; }
  .legend { font-size: 12px; gap: 6px; margin-bottom: 10px; }
  .legend.legend-bars { margin-top: 0; }
  .legend .desktop-edit { display: none; }
  h2.ch-title { font-size: 18px; margin-top: 26px; }
}
</style><link rel="manifest" href="./manifest.webmanifest">
<link rel="apple-touch-icon" href="./icon-180.png">
<meta name="theme-color" content="#2563eb">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="description" content="双语逐字稿、盲听练习与离线音频。">
<style>
.offline-panel { max-width: 840px; margin: 12px auto 0; padding: 10px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); }
.offline-row { display: flex; align-items: center; gap: 12px; justify-content: space-between; }
#offline-status { font-size: 14px; line-height: 1.5; }
#offline-status[data-state=ready] { color: var(--accent); }
#offline-download { flex: none; min-height: 44px; font-size: 14px; }
#offline-download:disabled { opacity: .7; }
#offline-progress { width: 100%; margin-top: 8px; }
#install-help { font-size: 13px; color: var(--muted); margin-top: 6px; }
.offline-tools { margin-top: 8px; font-size: 14px; }
.offline-tools summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; }
.offline-tool-buttons { display: flex; flex-wrap: wrap; gap: 8px; }
.offline-tool-buttons button { min-height: 44px; font-size: 14px; }
.offline-tools p { margin: 8px 0; color: var(--muted); line-height: 1.6; }
#app-version { font-size: 12px; }
#install-help summary { cursor: pointer; padding: 6px 0; }
#install-help p { margin: 4px 0; }
@media(max-width:760px), (hover:none) and (pointer:coarse) { .offline-panel { margin: 10px 12px 0; } }
</style>
<meta name="app-build" content="45efbe73c540">
</head>
<body class="show-zh-para">
<header>
  <div class="t-top" id="t-top" aria-label="手机阅读工具"><button id="t-menu" type="button" aria-label="目录" aria-controls="side" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><span id="t-title"></span><button id="t-annotate" type="button" aria-pressed="false">标注</button><button id="t-more" type="button" aria-label="更多" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="19" cy="12" r="1.4"/></svg></button></div>
  <div class="hdr-top">
    <h1 id="title" title="打开或拖入双语字幕（.srt）；再加载结构、标记与音视频">逐字稿</h1>
    <div class="hdr-controls">
      <audio id="audio" controls preload="metadata"></audio>
    </div>
  </div>
  <div id="loop-row" class="loop-row hidden">
    <span>🔁</span><span id="lr-label" class="lr-label"></span><span id="lr-time" class="lr-time"></span>
    <div id="loop-bar" class="loop-bar" title="循环区间内的进度：点击或拖动定位；色块 = 每一句（按说话人着色、相邻句交替深浅、关键句黄底、插话淡化），竖色线 = 换了一轮说话；刻度每 1 秒（长段落 5 秒 / 30 秒）"><div class="lb-fill"></div><div class="lb-head"></div></div>
    <button id="loop-stop" title="停止循环">停止</button>
  </div>
<div class="actions">
      <div class="group desktop-edit" title="加载材料文件（也可直接拖进页面）">
      <span class="grp-label">材料</span>
      <label class="btn" title="加载双语字幕 .srt">字幕<input type="file" id="srt-file" accept=".srt,.vtt"></label>
      <label class="btn" title="加载 .transcript-structure.json（章/节/段落/说话人）">结构<input type="file" id="struct-file" accept=".json"></label>
      <label class="btn" title="加载音频或视频">音视频<input type="file" id="audio-file" accept="audio/*,video/*,.mkv"></label>
    </div>
      <div class="group annotation-tools" title="听力层：漏听段落与关键句（segments.json）">
      <span class="grp-label">段落标记</span>
      <button id="select-btn" title="进入选句模式：点句子选中，Shift+点选一段，然后设为漏听段落或关键句">选句</button>
      <button id="mark-btn" title="按当前播放位置圈段：起点、终点各点一次；落在某个漏听段落内则成为它的关键句，否则成为新段落">圈段</button>
      <button id="export-seg" title="把当前全部漏听段落/关键句（含本页新建、修改的）导出为 segments.json">导出</button>
      <label class="btn" title="导入 segments.json，替换当前全部段落标记">导入<input type="file" id="seg-file" accept=".json"></label>
      <button id="reset-seg" title="丢弃本机编辑，恢复页面内嵌的标记文件版">重置</button>
    </div>
      <div class="group annotation-tools" title="阅读层：句内的生词 [[ ]] / 搭配·语法 （[[ ]]） / 疑问（highlights.json，用于生成 Logseq 笔记）">
      <span class="grp-label">词句标注</span>
      <button id="copy-passages" title="复制带 [[ ]] 标注的英文句子，可直接粘贴给学习助手">复制</button>
      <button id="export-hl" title="导出 highlights.json，交给学习助手生成 Logseq 笔记">导出</button>
      <label class="btn" title="导入 highlights.json">导入<input type="file" id="hl-file" accept=".json"></label>
      <button id="clear-hl" title="清空本篇全部词句标注">清空</button>
    </div>
    <div class="group reader-settings" aria-label="阅读设置">
      <button id="blind" title="盲听：只播放不显示字幕。独立开关，不改变当前显示模式，再点一次恢复（快捷键 B）">盲听</button>
      <button id="blind-peek" class="active" title="盲听时鼠标悬停某句是否临时看清：开 = 可偷看一句，并可在这一句上划词标注；关 = 完全盲听。只在盲听开着时生效（快捷键 P）">悬停</button>
      <button id="blind-para" title="盲听的第三档：正在播放的那一段（说话人的一轮）整段可见、可划词标注，其余遮蔽；关 = 全部不可见。只在盲听开着时生效（快捷键 D）">当前段</button>
      <button id="zh-cycle" title="点击循环切换显示模式：仅英文 → 英文+逐句中文 → 英文+段末中文 → 仅中文（快捷键 M）">英文+段末中文</button>
      <button id="zh-flip" title="在当前模式与上一次用的模式之间来回切换（快捷键 C）">⇄ 仅中文</button>
<label class="speed-menu">倍速<select id="speed" aria-label="播放速度"><option value="0.25">0.25×</option><option value="0.5">0.5×</option><option value="0.75">0.75×</option><option value="1">1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option><option value="1.75">1.75×</option><option value="2">2×</option></select></label>
      <button id="toggle-side">侧栏</button>
    </div>
  </div>
  <div class="hdr-media">
    <div id="video-pane" class="video-pane size-m">
      <div id="video-wrap" class="video-wrap">
        <video id="video" controls preload="metadata" playsinline></video>
        <div id="video-sub" class="video-sub"></div>
        <div id="mask" class="mask hidden" title="拖动移动，拖下边缘调高度"><div class="mask-grip"></div></div>
      </div>
      <div class="video-tools">
        <button data-vsize="s">小</button><button data-vsize="m" class="active">中</button><button data-vsize="l">大</button>
        <button id="video-hide" title="收起画面，只听声音；再点展开">收起画面</button>
        <button id="video-sub-toggle" class="active" title="画面上叠加当前句字幕，随显示模式（仅英/中英/仅中）变化">画面字幕</button>
        <button id="mask-toggle" title="遮挡画面里压死的字幕：拖动移动、拖下边缘调高度">蒙版</button>
      </div>
    </div>
  </div>
  <div id="timeline" class="timeline" title="漏听段落（上）与关键句（下）在整条时间线上的分布，点击跳转"><div class="tl-head" style="left:0"></div></div>
</header>
