    for (var i = r[0]; i <= r[1]; i++) {
      var c = document.getElementById('cue-' + i); if (c) c.classList.add('vis');
      var z = document.querySelector('.zhc[data-i="' + i + '"]'); if (z) z.classList.add('vis');
