  function paintReveal(id) { var on = state.revealed.has(id), el = document.getElementById('cue-' + id), zh = state.zhEls && state.zhEls[id]; if (el) el.classList.toggle('revealed', on); if (zh) zh.classList.toggle('revealed', on); }
