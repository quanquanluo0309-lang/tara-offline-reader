  function seekKeep(t) {
    var m = mediaEl(); if (!Number.isFinite(t)) return;
    if (state.loop && (t < state.loop.start || t >= state.loop.end)) setLoop(null);
    seek(t, !m.paused);
  }
  /** 阅读位置：正文可视区顶部（顶栏之下）第一句 */
  function readingCue() {
    var main = $('main').getBoundingClientRect(), x = main.left + Math.min(main.width - 40, 220), hdr = headerHeight(), ys = [hdr + 12, hdr + 48, hdr + 110, hdr + 200];
    for (var k = 0; k < ys.length; k++) { if (ys[k] > innerHeight - 10) break; var el = document.elementFromPoint(x, ys[k]), c = el && el.closest ? el.closest('.cue, .zhc') : null; if (c) return c.classList.contains('cue') ? c : document.getElementById('cue-' + c.dataset.i); }
    return null;
  }
