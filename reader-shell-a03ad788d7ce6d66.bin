  // ---------- 选区 → 标注 ----------
  function closestEn(node) { var el = node.nodeType === 3 ? node.parentElement : node; return el && el.closest ? el.closest('.en') : null; }
  function captureWordSelection(e) {
    if (isMobileReader()) return;
    var tg = e.target instanceof Element ? e.target : null;
    if (tg && (tg.closest('#popover') || tg.closest('header') || tg.closest('#side') || tg.closest('#selbar'))) return;
    if (state.selecting) return;
    setTimeout(function () {
      var sel = window.getSelection(); if (!sel || sel.isCollapsed || !sel.rangeCount) return;
      var range = sel.getRangeAt(0), a = closestEn(range.startContainer), b = closestEn(range.endContainer);
      if (isMobileReader() && a && state.blind && getComputedStyle(a).filter !== 'none') return;
      if (!a || !b) { if (state.zhMode === 'only' && (range.startContainer.parentElement || {}).closest && range.startContainer.parentElement.closest('.zh')) toast('标注只对英文句生效，请切换到含英文的显示模式'); return; }
      if (a !== b) { toast('请在同一句字幕内选择（跨句可分两次标）'); return; }
      var pre = document.createRange(); pre.selectNodeContents(a); pre.setEnd(range.startContainer, range.startOffset);
      var start = pre.toString().length, text = range.toString(), end = start + text.length;
      var lead = text.length - text.replace(/^\s+/, '').length, trail = text.length - text.replace(/\s+$/, '').length;
      start += lead; end -= trail; text = text.trim();
      if (!text) return;
      var cue = +a.closest('.cue').dataset.i;
      if (highlightsOf(cue).some(function (h) { return h.start < end && start < h.end; })) { toast('与已有标注重叠，先删除旧标注'); return; }
      showNewPopover(range.getBoundingClientRect(), { cue: cue, start: start, end: end, text: text });
    }, 0);
  }
  document.addEventListener('mouseup', captureWordSelection);
  function placePopover(rect) {
    var pop = $('popover'); pop.classList.add('show');
    var x = Math.min(Math.max(8, rect.left), window.innerWidth - pop.offsetWidth - 8), y = rect.bottom + 8;
    if (y + pop.offsetHeight > window.innerHeight - 8) y = Math.max(8, rect.top - pop.offsetHeight - 8);
    pop.style.left = x + 'px'; pop.style.top = y + 'px';
  }
  function hidePopover() { $('popover').classList.remove('show'); }
  function showNewPopover(rect, sel) {
    var pop = $('popover');
    pop.innerHTML = '<div class="sel">“' + esc(sel.text) + '”</div><div class="row">' +
      '<button class="b-vocab" data-k="vocab">生词 [[ ]]</button><button class="b-colloc" data-k="collocation">搭配/语法 （[[ ]]）</button><button class="b-q" data-k="question">疑问</button></div>' +
      '<input id="pop-note" placeholder="备注/问题（疑问必填，其余可选）" style="display:none">';
    pop.querySelectorAll('button').forEach(function (b) {
      b.onclick = function () {
        var k = b.dataset.k, inp = $('pop-note');
        if (k === 'question' && inp.style.display === 'none') { inp.style.display = 'block'; inp.focus(); inp.onkeydown = function (ev) { if (ev.key === 'Enter') b.click(); }; return; }
        var note = inp.value.trim();
        if (k === 'question' && !note) { inp.focus(); toast('写下你的问题'); return; }
        addHighlight(sel, k, note); hidePopover(); window.getSelection().removeAllRanges();
      };
    });
    placePopover(rect);
  }
  function showEditPopover(mark) {
    var h = state.highlights[mark.dataset.id]; if (!h) return;
    if (isMobileReader()) { Touch.highlightSheet(h); return; }
    var pop = $('popover');
    pop.innerHTML = '<div class="sel">' + esc(kindName(h.kind)) + '：“' + esc(h.text) + '”</div><div class="row">' +
      '<button data-k="vocab" class="b-vocab' + (h.kind === 'vocab' ? ' active' : '') + '">生词</button>' +
      '<button data-k="collocation" class="b-colloc' + (h.kind === 'collocation' ? ' active' : '') + '">搭配/语法</button>' +
      '<button data-k="question" class="b-q' + (h.kind === 'question' ? ' active' : '') + '">疑问</button>' +
      '<button class="del">删除</button></div><input id="pop-note" placeholder="备注/问题" value="' + esc(h.note || '') + '">';
    pop.querySelectorAll('button[data-k]').forEach(function (b) { b.onclick = function () { h.kind = b.dataset.k; h.note = $('pop-note').value.trim(); saveHighlights(); rerenderCue(h.cue); renderStats(); hidePopover(); }; });
    pop.querySelector('.del').onclick = function () { delete state.highlights[h.id]; saveHighlights(); rerenderCue(h.cue); renderStats(); hidePopover(); };
    $('pop-note').onchange = function () { h.note = this.value.trim(); saveHighlights(); rerenderCue(h.cue); };
    placePopover(mark.getBoundingClientRect());
  }
  function addHighlight(sel, kind, note) {
    if (sel.parts) { sel.parts.forEach(function (part) { addHighlight(part, kind, note); }); return; }
    var id = uid();
    state.highlights[id] = { id: id, cue: sel.cue, start: sel.start, end: sel.end, text: sel.text, kind: kind, note: note || '', createdAt: Date.now() };
    saveHighlights(); rerenderCue(sel.cue); renderStats(); toast(kindName(kind) + ' 已标注');
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      if (Touch.escape()) { e.preventDefault(); return; }
      hidePopover(); return;
    }
    var tg = e.target instanceof Element ? e.target : null;
    if (tg && (tg.tagName === 'INPUT' || tg.tagName === 'TEXTAREA' || tg.tagName === 'SELECT' || tg.closest('#t-sheet') || tg.isContentEditable)) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    // 空格 = 播放/暂停（不再翻页）；焦点在按钮或原生播放器控件上时交给它们自己处理，避免双重触发
    if (e.key === ' ' || e.code === 'Space') {
      if (tg && (tg.tagName === 'BUTTON' || tg.tagName === 'A' || tg.tagName === 'SELECT' || tg.tagName === 'AUDIO' || tg.tagName === 'VIDEO')) return;
      var m = mediaEl(); e.preventDefault();
      if (!m.getAttribute('src')) { toast('先加载音频/视频'); return; }
      if (m.paused) m.play().catch(function () {}); else m.pause();
      return;
    }
    if (e.key === '[') { stepSpeed(-1); e.preventDefault(); }
    else if (e.key === ']') { stepSpeed(1); e.preventDefault(); }
    else if (e.key === 'm' || e.key === 'M') { cycleZhMode(); e.preventDefault(); }
    else if (e.key === 'c' || e.key === 'C') { flipZhMode(); e.preventDefault(); }
    else if (e.key === 'b' || e.key === 'B') { toggleBlind(); e.preventDefault(); }
    else if (e.key === 'p' || e.key === 'P') { if (state.blind) toggleBlindPeek(); else toast('先开盲听（B），P 才有意义'); e.preventDefault(); }
    else if (e.key === 'd' || e.key === 'D') { if (state.blind) toggleBlindPara(); else toast('先开盲听（B），D 才有意义'); e.preventDefault(); }
    else if (e.key === 'L' && e.shiftKey) { if (state.loop && state.loop.para) { setLoop(null); toast('已停止小段循环'); } else if (state.activeCue !== null) { var pe = document.getElementById('cue-' + state.activeCue).closest('.para'); if (pe) loopPara(+pe.dataset.lo, +pe.dataset.hi); } else toast('先播放到某一句，Shift+L 才知道循环哪段'); e.preventDefault(); }
    else if (e.key === 'l' || e.key === 'L') { if (state.loop && state.loop.cue) { setLoop(null); toast('已停止单句循环'); } else if (state.activeCue !== null) loopCue(state.activeCue); else toast('先播放到某一句，L 才知道循环哪句'); e.preventDefault(); }
  });

  // ---------- 导入 / 导出 ----------
  function sortedHighlights() { return Object.values(state.highlights).sort(function (a, b) { return a.cue - b.cue || a.start - b.start; }); }
  function exportData() {
    var hs = sortedHighlights();
    return { version: 1, kind: 'transcript-highlights', slug: state.data.slug || '', title: state.data.title || '', source: state.data.source || '', transcriptHash: state.hash,
      exportedAt: new Date().toISOString(),
      stats: { vocab: hs.filter(function (h) { return h.kind === 'vocab'; }).length, collocation: hs.filter(function (h) { return h.kind === 'collocation'; }).length, question: hs.filter(function (h) { return h.kind === 'question'; }).length },
      highlights: hs.map(function (h) { var c = state.cueById[h.cue]; return { id: h.id, cue: h.cue, time: c ? c.s : null, start: h.start, end: h.end, text: h.text, kind: h.kind, note: h.note || '', cueText: c ? c.en : '' }; }) };
  }
  function passagesText() {
    var byCue = {}; sortedHighlights().forEach(function (h) { (byCue[h.cue] = byCue[h.cue] || []).push(h); });
    return Object.keys(byCue).map(Number).sort(function (a, b) { return a - b; }).map(function (i) {
      var c = state.cueById[i], t = c.en, out = '', pos = 0, qs = [];
      byCue[i].forEach(function (h) {
        out += t.slice(pos, h.start);
        var piece = t.slice(h.start, h.end);
        out += h.kind === 'vocab' ? '[[' + piece + ']]' : h.kind === 'collocation' ? '（[[' + piece + ']]）' : piece;
        if (h.kind === 'question') qs.push('❓ “' + piece + '”：' + h.note);
        else if (h.note) qs.push('📝 “' + piece + '”：' + h.note);
        pos = h.end;
      });
      out += t.slice(pos);
      return '[' + fmt(c.s) + ' · cue ' + i + '] ' + out + (qs.length ? '\n  ' + qs.join('\n  ') : '');
    }).join('\n');
  }
  $('export-hl').onclick = function () { if (!state.data) return; download((state.data.slug || 'transcript') + '.highlights.json', JSON.stringify(exportData(), null, 2)); toast('已导出 .highlights.json'); };
  $('copy-passages').onclick = function () { if (!state.data) return; var t = passagesText(); if (!t) { toast('还没有标注'); return; } navigator.clipboard.writeText(t).then(function () { toast('已复制标注文本'); }, function () { toast('复制失败'); }); };
  $('clear-hl').onclick = function () { if (!Object.keys(state.highlights).length) return; if (!confirm('清空本篇全部标注？')) return; state.highlights = {}; saveHighlights(); render(); };
  function importHighlights(text) {
    var d = JSON.parse(text);
    if (!d || d.kind !== 'transcript-highlights' || !Array.isArray(d.highlights)) throw new Error('不是逐字稿标注文件');
    if (d.transcriptHash && d.transcriptHash !== state.hash && !confirm('标注来自另一份字幕（hash 不同），仍然导入？')) return;
    var n = 0; d.highlights.forEach(function (h) {
      if (!state.cueById[h.cue]) return;
      if (highlightsOf(h.cue).some(function (x) { return x.start < h.end && h.start < x.end; })) return;
      var id = h.id || uid(); state.highlights[id] = { id: id, cue: h.cue, start: h.start, end: h.end, text: h.text, kind: h.kind, note: h.note || '', createdAt: Date.now() }; n++;
    });
    saveHighlights(); render(); toast('导入 ' + n + ' 条标注');
  }

  // ---------- 文件加载 ----------
  function handleFile(file) {
    var name = file.name.toLowerCase();
    if (/\.(srt|vtt)$/.test(name)) {
      file.text().then(function (t) { var cues = parseSrt(t); if (!cues.length) { toast('未解析出字幕'); return; }
        var slug = file.name.replace(/\.(bilingual\.)?(srt|vtt)$/i, '');
        loadData({ title: slug, slug: slug, source: file.name, cues: cues, structure: state.structure, located: state.located, audio: '' }); toast('已加载字幕 ' + cues.length + ' 句'); });
    } else if (/\.json$/.test(name)) {
      file.text().then(function (t) {
        try { var d = JSON.parse(t);
          if (!state.data) { toast('先加载字幕'); return; }
          if (d && d.kind === 'transcript-highlights') { importHighlights(t); return; }
          if (d && Array.isArray(d.chapters)) { state.structure = d; state.data.structure = d; render(); toast('已加载结构：' + d.chapters.length + ' 章'); return; }
          state.located = parseSegments(t, state.cues); state.data.located = state.located; state.locBase = hashStr(JSON.stringify(state.located)); saveLocated(); render(); toast('已导入 ' + state.located.length + ' 个漏听段落（已替换）');
        } catch (e) { toast('无法识别：' + e.message); }
      });
    } else if (/^(audio|video)\//.test(file.type) || /\.(mp3|m4a|wav|ogg|mp4|webm|mkv|mov|m4v)$/.test(name)) {
      setMediaSource(URL.createObjectURL(file), isVideoFile(file) ? 'video' : 'audio', file.name); toast('已加载' + (state.mediaType === 'video' ? '视频 ' : '音频 ') + file.name);
    } else toast('不支持的文件：' + file.name);
  }
  ['srt-file', 'struct-file', 'seg-file', 'audio-file', 'hl-file'].forEach(function (id) { $(id).onchange = function () { if (this.files[0]) handleFile(this.files[0]); this.value = ''; }; });
  document.addEventListener('dragover', function (e) { e.preventDefault(); document.body.classList.add('dragging'); });
  document.addEventListener('dragleave', function (e) { if (!e.relatedTarget) document.body.classList.remove('dragging'); });
  document.addEventListener('drop', function (e) { e.preventDefault(); document.body.classList.remove('dragging'); Array.from(e.dataTransfer.files).forEach(handleFile); });

  // ---------- 偏好 ----------
  $('blind').onclick = toggleBlind;
  $('blind-peek').onclick = toggleBlindPeek;
  $('blind-para').onclick = toggleBlindPara;
  $('zh-cycle').onclick = cycleZhMode;
  $('zh-flip').onclick = flipZhMode;
  $('follow-side').onclick = function () { cycleLink('ps'); };
  $('follow-page').onclick = function () { cycleLink('pp'); };
  $('follow-block').onclick = function () { cycleLink('sp'); };
  $('toggle-side').onclick = function () { document.body.classList.toggle('side-hidden'); savePrefs(); revealSideNow(); };

  // ============================================================
  // 触屏壳：手机 / 平板。自己的顶栏、底栏、抽屉、情境条与菜单；核心只通过 Touch.* 钩子通知它，不搬运桌面控件。
  // 手势词汇（阅读态 / 遮盖 / 标注态）见 design-review-2026-09-30.md §3.3：单击只在 click 处理，长按由 pointerdown 计时并吞掉随后那一次 click。
  // ============================================================
  var Touch = (function () {
    var mounted = false, annotating = false, followSuspended = false, programmaticUntil = 0;
    var press = null, swallowClick = false, swallowTimer = 0;
    var range = null;      // 两点圈选 { a, b|null }
    var pick = null;       // 选词 { cue, start, end, anchor: [s, e] }
    var seeking = false, popKind = null, barRO = null;
    var main = $('main'), bar = $('t-bar'), ctx = $('t-ctx'), pop = $('t-pop'), sheet = $('t-sheet'), pill = $('t-pill');
    var MODE_SHORT = { off: '英', cue: '英中', para: '英+段', only: '中' };
    var WORD_RE = /[\p{L}\p{N}]+(?:['’\-][\p{L}\p{N}]+)*/gu;

    // ---------- 装卸 ----------
    function measureBar() { if (!mounted) return; document.documentElement.style.setProperty('--tbar', bar.offsetHeight + 'px'); }
    function mount() {
      if (mounted) return; mounted = true;
      document.body.classList.add('touch-reader'); audio.controls = video.controls = false;
      if (typeof ResizeObserver !== 'undefined' && !barRO) { barRO = new ResizeObserver(measureBar); barRO.observe(bar); }
      measureBar(); syncTransport(); sync(); renderMarks();
    }
    function unmount() {
      if (!mounted) return;
      closeAll(); setAnnotating(false, true); clearRange(); clearPick(); followSuspended = false; pill.hidden = true;
      mounted = false; document.body.classList.remove('touch-reader', 'annotating'); audio.controls = video.controls = true;
      document.documentElement.style.removeProperty('--tbar');
    }
    function closeAll() { closePop(); closeSheet(); closeDrawer(); }

    // ---------- 命中：正文文字（含行内空隙）→ 所在句 ----------
    function textAt(target, x, y) {
      if (!target || !target.closest || !target.closest('#main')) return null;
      if (target.closest('button, a, input, select, textarea, .key-tag, [data-fold], .loc-head, summary')) return null;
      var hit = target.closest('.cue, .zhc'); if (hit) return hit;
      var block = target.closest('.para, .zh-para'); if (!block || typeof x !== 'number') return null;
      var r = document.caretRangeFromPoint ? document.caretRangeFromPoint(x, y) : null, n = r && r.startContainer, el = n ? (n.nodeType === 3 ? n.parentElement : n) : null;
      return el && el.closest ? el.closest('.cue, .zhc') : null;
    }
    function cueIdOf(el) { return el ? +el.dataset.i : null; }

    // ---------- 长按 = 上下文菜单 ----------
    main.addEventListener('pointerdown', function (e) {
      if (!mounted || !e.isPrimary || (e.pointerType === 'mouse' && e.button !== 0)) return;
      var head = e.target.closest ? e.target.closest('.loc-head') : null, el = head ? null : textAt(e.target, e.clientX, e.clientY);
      if (!head && !el) return;
      cancelPress();
      press = { x: e.clientX, y: e.clientY, el: el, head: head, id: cueIdOf(el) };
      press.feedback = setTimeout(function () { if (press && press.el) press.el.classList.add('pressing'); }, 180);
      press.timer = setTimeout(function () { var p = press; cancelPress(); longPress(p); }, 450);
    }, { passive: true });
    main.addEventListener('pointermove', function (e) { if (press && Math.hypot(e.clientX - press.x, e.clientY - press.y) > 8) cancelPress(); }, { passive: true });
    main.addEventListener('pointerup', cancelPress, { passive: true });
    main.addEventListener('pointercancel', cancelPress, { passive: true });
    // 长按已经开出菜单后，手指抬起时浏览器仍会合成一次 click（可能落在刚打开的菜单上）：在 document 捕获阶段吞掉这一次，不管它落在哪
    document.addEventListener('pointerup', function () { if (swallowClick) { clearTimeout(swallowTimer); swallowTimer = setTimeout(function () { swallowClick = false; }, 500); } }, { capture: true, passive: true });
    document.addEventListener('pointercancel', function () { swallowClick = false; }, { capture: true, passive: true });
    document.addEventListener('click', function (e) { if (!swallowClick) return; swallowClick = false; clearTimeout(swallowTimer); e.stopPropagation(); e.preventDefault(); }, true);
    main.addEventListener('contextmenu', function (e) { if (mounted) e.preventDefault(); });
    function cancelPress() { if (!press) return; clearTimeout(press.timer); clearTimeout(press.feedback); if (press.el) press.el.classList.remove('pressing'); press = null; }
    function longPress(p) {
      if (!p) return; swallowClick = true;
      if (p.head) { locSheet(+p.head.closest('.loc-block').dataset.loc); return; }
      if (p.id !== null && state.cueById[p.id]) cueSheet(p.id);
    }

    // ---------- 单击（capture：先于文档级处理器；只拦正文文字、标注、区块标题栏，控件放行） ----------
    main.addEventListener('click', function (e) {
      if (!mounted) return;
      var tg = e.target instanceof Element ? e.target : null; if (!tg) return;
      var head = tg.closest('.loc-head');
      if (head && !tg.closest('button, input')) { e.stopPropagation(); e.preventDefault(); locSheet(+head.closest('.loc-block').dataset.loc); return; }
      var mark = tg.closest('mark.hl'), el = textAt(tg, e.clientX, e.clientY);
      if (!el) return;
      e.stopPropagation(); e.preventDefault();
      var id = cueIdOf(el);
      if (mark && !(state.blind && !annotating && !state.revealed.has(id))) { var h = state.highlights[mark.dataset.id]; if (h) { highlightSheet(h); return; } }
      onTap(e, el, id);
    }, true);
    function onTap(e, el, id) {
      var c = state.cueById[id]; if (!c) return;
      if (annotating) { pickWordAt(e, el, id); return; }
      if (range) { setRangeEnd(id); return; }
      if (state.blind) { toggleRevealAt(id); return; }
      localSeekGuard(); resumeFollow(); seekKeep(c.s);
    }

    // ---------- 跟随：手动滚动即暂停，浮出「回到当前句」 ----------
    function userScrolled(e) { if (!mounted || followSuspended || Date.now() < programmaticUntil) return; if (e && e.target && e.target.closest && e.target.closest('#side, #t-sheet, #t-pop, #t-ctx')) return; followSuspended = true; updatePill(); }
    window.addEventListener('touchmove', userScrolled, { passive: true });
    window.addEventListener('wheel', userScrolled, { passive: true });
    var pillTick = false;
    window.addEventListener('scroll', function () { if (!mounted || pillTick) return; pillTick = true; requestAnimationFrame(function () { pillTick = false; updatePill(); }); }, { passive: true });
    function activeEl() { return state.activeCue !== null ? document.getElementById('cue-' + state.activeCue) : null; }
    function updatePill() { var el = activeEl(); pill.hidden = !(mounted && followSuspended && el && !inView(el)); }
    function resumeFollow() { followSuspended = false; pill.hidden = true; }
    pill.onclick = function () { var el = activeEl(); resumeFollow(); if (el) followScroll(el); };

    // ---------- 底栏：播放 / 逐句 / 循环 / 显示 / 倍速 / 进度 ----------
    $('t-play').onclick = function () { var m = mediaEl(); if (!m.getAttribute('src')) { toast('先加载音频 / 视频'); return; } if (m.paused) m.play().catch(function () { toast('无法播放，请检查媒体或下载状态'); }); else m.pause(); };
    $('t-prev').onclick = function () { resumeFollow(); stepCue(-1); };
    $('t-next').onclick = function () { resumeFollow(); stepCue(1); };
    var loopPress = 0;
    $('t-loop').addEventListener('pointerdown', function () { clearTimeout(loopPress); loopPress = setTimeout(function () { swallowClick = true; loopSheet(); }, 450); });
    ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (n) { $('t-loop').addEventListener(n, function () { clearTimeout(loopPress); }); });
    $('t-loop').onclick = function () {
      if (state.loop) { setLoop(null); toast('已停止循环'); return; }
      if (state.activeCue === null) { toast('先播放到某一句，或长按选择循环范围'); return; }
      localSeekGuard(); loopCue(state.activeCue);
    };
    $('t-loopstop').onclick = function () { setLoop(null); };
    $('t-mode').onclick = function () { togglePop('mode'); };
    $('t-rate').onclick = function () { togglePop('rate'); };
    var seekEl = $('t-seek');
    seekEl.addEventListener('pointerdown', function () { seeking = true; });
    seekEl.addEventListener('input', function () { seeking = true; $('t-pos').textContent = state.loop ? loopSec(+this.value - state.loop.start) : fmt(+this.value); });
    seekEl.addEventListener('change', function () { var v = +this.value; seeking = false; localSeekGuard(); resumeFollow(); if (state.loop && v >= state.loop.start && v < state.loop.end) { mediaEl().currentTime = v; updateLoopBar(v); } else seekKeep(v); syncTransport(); });
    ['pointercancel', 'blur'].forEach(function (n) { seekEl.addEventListener(n, function () { seeking = false; syncTransport(); }); });
    function loopSec(s) { return Math.max(0, s).toFixed(1) + 's'; }
    function syncTransport() {
      if (!mounted) return;
      var m = mediaEl(), D = Number.isFinite(m.duration) ? m.duration : 0, t = m.currentTime || 0, L = state.loop;
      $('t-play').classList.toggle('is-playing', !m.paused); $('t-play').setAttribute('aria-label', m.paused ? '播放' : '暂停');
      $('t-play').disabled = !m.getAttribute('src');
      seekEl.disabled = !D && !L;
      if (L) { seekEl.min = String(L.start); seekEl.max = String(L.end); seekEl.step = '0.05'; }
      else { seekEl.min = '0'; seekEl.max = String(D || 1); seekEl.step = '0.1'; }
      if (!seeking) { seekEl.value = String(t); $('t-pos').textContent = L ? loopSec(t - L.start) : fmt(t); }
      $('t-dur').textContent = L ? loopSec(L.end - L.start) : (D ? fmt(D) : '--:--');
      $('t-marks').hidden = !!L; $('t-loopbar').hidden = !L; $('t-loopinfo').hidden = !L;
      if (!L && D) { var fill = $('t-marks').querySelector('b'); if (fill) fill.style.width = (t / D * 100) + '%'; }
    }
    [audio, video].forEach(function (m) { ['play', 'pause', 'timeupdate', 'durationchange', 'loadedmetadata', 'emptied', 'ended', 'seeked'].forEach(function (n) { m.addEventListener(n, function () { if (m === mediaEl()) syncTransport(); }); }); });
    /** 底栏进度条底层：漏听段落在整条音频上的分布（与桌面时间线同源） */
    function renderMarks() {
      if (!mounted) return; var D = mediaDuration(), box = $('t-marks'); if (!D) return;
      box.innerHTML = '<b></b>' + state.located.map(function (p) { return '<i style="left:' + (p.startTime / D * 100) + '%;width:' + Math.max((p.endTime - p.startTime) / D * 100, 0.3) + '%"></i>'; }).join('');
    }
    function loopTime(label) { if (mounted) $('t-looptime').textContent = label; }

    // ---------- 小面板：显示 / 遮盖、倍速 ----------
    function togglePop(kind) { if (!pop.hidden && popKind === kind) { closePop(); return; } closeSheet(); closeDrawer(); popKind = kind; pop.hidden = false; renderPop(); }
    function closePop() { pop.hidden = true; popKind = null; }
    function renderPop() {
      if (pop.hidden) return;
      if (popKind === 'rate') {
        var idx = Math.max(0, SPEEDS.indexOf(state.speed));
        pop.innerHTML = '<div class="head"><span>播放速度</span><output>' + state.speed + '×</output></div><input type="range" min="0" max="' + (SPEEDS.length - 1) + '" step="1" value="' + idx + '" aria-label="播放速度档位"><div class="ends"><span>0.25×</span><span>1×</span><span>2×</span></div>';
        pop.querySelector('input').oninput = function () { setSpeed(SPEEDS[+this.value]); pop.querySelector('output').textContent = state.speed + '×'; };
        return;
      }
      var seg = function (attr, items, cur) { return '<div class="seg">' + items.map(function (it) { return '<button type="button" data-' + attr + '="' + it[0] + '"' + (it[0] === cur ? ' class="active"' : '') + (it[2] ? ' disabled' : '') + '>' + it[1] + '</button>'; }).join('') + '</div>'; };
      pop.innerHTML = '<div class="t-row" style="margin-top:0"><span>显示</span></div>' +
        seg('mode', [['off', '英文'], ['cue', '逐句对照'], ['para', '段末对照'], ['only', '中文']], state.zhMode) +
        '<div class="t-row"><span>遮盖字幕 <span class="hint">· 轻点句子揭开 / 盖回</span></span><button type="button" class="sw" id="t-cover" role="switch" aria-checked="' + state.blind + '" aria-label="遮盖字幕"></button></div>' +
        '<div class="t-row"><span>轻点范围</span>' + seg('scope', [['cue', '一句', !state.blind], ['para', '一段', !state.blind]], state.coverScope) + '</div>' +
        '<div class="t-row"><span class="hint">一段 = 说话人的一轮</span><span><button type="button" class="mini" id="t-revealall"' + (state.blind ? '' : ' disabled') + '>全部揭开</button> <button type="button" class="mini" id="t-coverall"' + (state.blind ? '' : ' disabled') + '>全部盖上</button></span></div>';
      pop.querySelectorAll('[data-mode]').forEach(function (b) { b.onclick = function () { setZhMode(b.dataset.mode); renderPop(); }; });
      pop.querySelectorAll('[data-scope]').forEach(function (b) { b.onclick = function () { state.coverScope = b.dataset.scope; savePrefs(); renderPop(); }; });
      $('t-cover').onclick = function () { toggleBlind(); renderPop(); };
      $('t-revealall').onclick = function () { setRevealed([state.cues[0].i, state.cues[state.cues.length - 1].i], true); toast('已全部揭开'); };
      $('t-coverall').onclick = function () { setRevealed([state.cues[0].i, state.cues[state.cues.length - 1].i], false); toast('已全部盖上'); };
    }
    document.addEventListener('pointerdown', function (e) { if (!mounted || pop.hidden) return; if (!e.target.closest('#t-pop, #t-mode, #t-rate')) closePop(); }, { capture: true, passive: true });

    // ---------- 抽屉 ----------
    function openDrawer() { closePop(); closeSheet(); document.body.classList.add('t-drawer-open'); $('t-scrim').hidden = false; $('t-menu').setAttribute('aria-expanded', 'true');
      requestAnimationFrame(function () { var panel = $('toc').classList.contains('active') ? $('toc') : $('loclist'); revealInPanel(panel.querySelector('a.now') || panel.querySelector('a.active'), panel); }); }
    function closeDrawer() { if (!document.body.classList.contains('t-drawer-open')) return; document.body.classList.remove('t-drawer-open'); $('t-scrim').hidden = true; $('t-menu').setAttribute('aria-expanded', 'false'); updateScrollSpy(); }
    $('t-menu').onclick = function () { if (document.body.classList.contains('t-drawer-open')) closeDrawer(); else openDrawer(); };
    $('t-scrim').onclick = closeDrawer;
    $('side').addEventListener('click', function (e) { if (mounted && e.target.closest('#toc a, #loclist a')) { resumeFollow(); setTimeout(closeDrawer, 0); } });
    $('t-tocseek').onclick = function () { state.link.ps.b = !state.link.ps.b; savePrefs(); syncDrawerFoot(); };
    function syncDrawerFoot() { $('t-tocseek').setAttribute('aria-checked', String(!!state.link.ps.b)); }

    // ---------- 顶栏：标注 / 更多 ----------
    $('t-annotate').onclick = function () { setAnnotating(!annotating); };
    $('t-more').onclick = function () { moreSheet(); };
    function setAnnotating(on, silent) {
      on = !!on; if (on === annotating && !silent) return;
      annotating = on; document.body.classList.toggle('annotating', on);
      clearPick(); clearRange(); closePop(); closeDrawer();
      if (on && state.blind) { state.blind = false; applyBlind(); savePrefs(); }
      sync();
      if (!silent) toast(on ? '标注：轻点一个词；再点同句里的末词可选短语' : '已退出标注');
    }

    // ---------- 选词（标注态）：caretRangeFromPoint 取字符偏移 → 词边界；同句第二次轻点扩成短语 ----------
    function tokenAt(text, offset) {
      var re = new RegExp(WORD_RE.source, 'gu'), m, best = null;
      while ((m = re.exec(text))) { var s = m.index, e2 = s + m[0].length; if (offset >= s && offset <= e2) return [s, e2]; if (!best || Math.abs(s - offset) < Math.abs(best[0] - offset)) best = [s, e2]; }
      return best;
    }
    function offsetIn(en, x, y) {
      var r = null;
      if (document.caretRangeFromPoint) r = document.caretRangeFromPoint(x, y);
      else if (document.caretPositionFromPoint) { var p = document.caretPositionFromPoint(x, y); if (p) { r = document.createRange(); r.setStart(p.offsetNode, p.offset); } }
      if (!r || !en.contains(r.startContainer)) return null;
      var pre = document.createRange(); pre.selectNodeContents(en); pre.setEnd(r.startContainer, r.startOffset);
      return pre.toString().length;
    }
    function pickWordAt(e, el, id) {
      if (!el.classList.contains('cue')) { toast('标注只对英文句生效'); return; }
      var en = el.querySelector('.en'), c = state.cueById[id]; if (!en) return;
      var off = offsetIn(en, e.clientX, e.clientY); if (off === null) return;
      var tok = tokenAt(c.en, off); if (!tok) return;
      var next = pick && pick.cue === id ? { cue: id, start: Math.min(pick.anchor[0], tok[0]), end: Math.max(pick.anchor[1], tok[1]), anchor: pick.anchor } : { cue: id, start: tok[0], end: tok[1], anchor: tok };
      if (highlightsOf(id).some(function (h) { return h.start < next.end && next.start < h.end; })) { toast('与已有标注重叠：点那条标注可修改或删除'); return; }
      var prev = pick; pick = next; state.picking = { cue: id, start: pick.start, end: pick.end };
      if (prev && prev.cue !== id) rerenderCue(prev.cue);
      rerenderCue(id); renderCtx();
    }
    function clearPick() { if (!pick) return; var c = pick.cue; pick = null; state.picking = null; rerenderCue(c); renderCtx(); }
    function savePick(kind, note) {
      if (!pick) return; var c = state.cueById[pick.cue], sel = { cue: pick.cue, start: pick.start, end: pick.end, text: c.en.slice(pick.start, pick.end) };
      clearPick(); addHighlight(sel, kind, note || '');
    }

    // ---------- 两点圈选：起点句 → 终点句；页面全程可滚动 ----------
    function startRange(id) { clearRange(); setAnnotating(false, true); range = { a: id, b: null }; paintRange(); renderCtx(); toast('起点已选：轻点终点句'); }
    function setRangeEnd(id) {
      if (!range) return;
      if (range.b === null) range.b = id; else if (id < range.a) range.a = id; else range.b = id;
      if (range.b < range.a) { var t = range.a; range.a = range.b; range.b = t; }
      paintRange(); renderCtx();
    }
    function rangeArr() { return range ? [range.a, range.b === null ? range.a : range.b] : null; }
    function paintRange() {
      document.querySelectorAll('#main .in-range').forEach(function (n) { n.classList.remove('in-range'); });
      var r = rangeArr(); if (!r) return;
      for (var n = r[0]; n <= r[1]; n++) { var el = document.getElementById('cue-' + n); if (el) el.classList.add('in-range'); var z = state.zhEls && state.zhEls[n]; if (z) z.classList.add('in-range'); }
    }
    function clearRange() { if (!range) return; range = null; paintRange(); renderCtx(); }
    function markKey(r) {
      var pi = containingParagraph(r, -1);
      if (pi >= 0) { addSentence(pi, r, ''); return; }
      form('保存关键句', '<p>所选句子不在任何漏听段落内。将同时建立覆盖它的漏听段落，并把它保存为关键句。</p><label>段落标签（可选）<input id="f-label" placeholder="便于回顾的名字"></label>',
        [['建段并保存', function () { var tm = cueTimes(r), label = $('f-label').value.trim(); state.located.push({ label: label || '段落 ' + fmt(tm.startTime), startTime: tm.startTime, endTime: tm.endTime, cues: r.slice(), sentences: [], createdAt: Date.now() }); addSentence(state.located.length - 1, r, ''); }]]);
    }
    function saveRange(kind) {
      var r = rangeArr(); if (!r) return;
      var c0 = state.cueById[r[0]], c1 = state.cueById[r[1]], n = r[1] - r[0] + 1, pi = kind === 'sent' ? containingParagraph(r, -1) : -1, needParent = kind === 'sent' && pi < 0;
      form(kind === 'sent' ? '保存关键句' : '保存漏听段落',
        '<p>' + fmt(c0.s) + '–' + fmt(c1.e) + ' · ' + n + ' 句' + (kind === 'sent' ? (needParent ? '<br>所选句子不在任何漏听段落内，将同时建立覆盖它的段落。' : '<br>属于：漏听 #' + state.locOrder[pi] + ' ' + esc(state.located[pi].label || '')) : '') + '</p><label>标签（可选）<input id="f-label" placeholder="便于回顾的名字"></label>',
        [[needParent ? '建段并保存关键句' : '保存', function () {
          var label = $('f-label').value.trim(); clearRange();
          if (kind !== 'sent') { addParagraph(r, label || '段落 ' + fmt(c0.s)); return; }
          if (needParent) { var tm = cueTimes(r); state.located.push({ label: '段落 ' + fmt(tm.startTime), startTime: tm.startTime, endTime: tm.endTime, cues: r.slice(), sentences: [], createdAt: Date.now() }); pi = state.located.length - 1; }
          addSentence(pi, r, label);
        }]], '返回选区');
    }
    function endAtPlayhead() { var c = findCue(mediaEl().currentTime); if (!c) { toast('播放位置没有字幕句'); return; } setRangeEnd(c.i); }

    // ---------- 情境条（圈选 / 选词二选一） ----------
    function renderCtx() {
      if (!mounted || (!range && !pick)) { ctx.hidden = true; ctx.innerHTML = ''; measureBar(); return; }
      ctx.hidden = false;
      if (pick) {
        var c = state.cueById[pick.cue];
        ctx.innerHTML = '<span class="txt">已选 <b>' + esc(c.en.slice(pick.start, pick.end)) + '</b> · 再点同句末词可扩成短语</span>' +
          '<button type="button" class="b-vocab" data-kind="vocab">生词</button><button type="button" class="b-colloc" data-kind="collocation">搭配 / 语法</button><button type="button" class="b-q" data-kind="question">疑问</button><button type="button" data-act="x">✕</button>';
        ctx.querySelectorAll('[data-kind]').forEach(function (b) { b.onclick = function () { var k = b.dataset.kind; if (k !== 'question') { savePick(k, ''); return; }
          form('记录疑问', '<p class="q">“' + esc(c.en.slice(pick.start, pick.end)) + '”</p><label>问题<input id="f-note" placeholder="写下想弄懂的问题"></label>', [['保存疑问', function () { var note = $('f-note').value.trim(); if (!note) { toast('请先写下问题'); return false; } savePick('question', note); }]]); }; });
        ctx.querySelector('[data-act="x"]').onclick = clearPick;
      } else {
        var r = rangeArr(), a = state.cueById[r[0]], b = state.cueById[r[1]];
        ctx.innerHTML = '<span class="txt">' + (range.b === null ? '起点 <b>' + fmt(a.s) + '</b> · 轻点终点句（或播放到终点后按下方按钮）' : '<b>' + fmt(a.s) + '–' + fmt(b.e) + '</b> · ' + (r[1] - r[0] + 1) + ' 句 · 再点别的句子可调整') + '</span>' +
          '<button type="button" data-act="para"' + (range.b === null ? ' disabled' : '') + '>漏听段落</button><button type="button" data-act="sent"' + (range.b === null ? ' disabled' : '') + '>关键句</button><button type="button" data-act="head">终点 = 播放处</button><button type="button" data-act="x">取消</button>';
        ctx.querySelector('[data-act="para"]').onclick = function () { saveRange('para'); };
        ctx.querySelector('[data-act="sent"]').onclick = function () { saveRange('sent'); };
        ctx.querySelector('[data-act="head"]').onclick = endAtPlayhead;
        ctx.querySelector('[data-act="x"]').onclick = clearRange;
      }
      measureBar();
    }

    // ---------- 菜单与表单：一个 dialog 复用 ----------
    var sheetOpenedAt = 0;
    function openSheet() { closePop(); if (!sheet.open) sheet.showModal(); sheetOpenedAt = Date.now(); }
    function closeSheet() { if (sheet.open) sheet.close(); }
    // 长按开出菜单时手指还没抬起，随后的合成 click 落在 dialog 背景上：刚打开的 500 ms 内不当作「点背景关闭」
    sheet.addEventListener('click', function (e) { if (e.target === sheet && Date.now() - sheetOpenedAt > 300) closeSheet(); });
    /** items: [label, handler, {sub, cls}] */
    function menu(title, items, cancelLabel) {
      sheet.innerHTML = '<h3>' + title + '</h3><div class="items">' + items.map(function (it, i) { var o = it[2] || {}; return '<button type="button" data-i="' + i + '"' + (o.cls ? ' class="' + o.cls + '"' : '') + '>' + it[0] + (o.sub ? '<small>' + o.sub + '</small>' : '') + '</button>'; }).join('') + '</div><button type="button" class="cancel">' + (cancelLabel || '取消') + '</button>';
      sheet.querySelectorAll('[data-i]').forEach(function (b) { b.onclick = function () { closeSheet(); items[+b.dataset.i][1](); }; });
      sheet.querySelector('.cancel').onclick = closeSheet;
      openSheet();
    }
    /** buttons: [label, handler → 返回 false 表示校验未过、不关闭] */
    function form(title, html, buttons, cancelLabel) {
      sheet.innerHTML = '<h3>' + title + '</h3>' + html + '<div class="row">' + buttons.map(function (b, i) { return '<button type="button" class="primary" data-i="' + i + '">' + b[0] + '</button>'; }).join('') + '<button type="button" class="cancel-inline">' + (cancelLabel || '取消') + '</button></div>';
      sheet.querySelectorAll('[data-i]').forEach(function (b) { b.onclick = function () { if (buttons[+b.dataset.i][1]() !== false) closeSheet(); }; });
      sheet.querySelector('.cancel-inline').onclick = closeSheet;
      sheet.querySelectorAll('input').forEach(function (input) { input.autocomplete = 'off'; });
      openSheet();
      var first = sheet.querySelector('input'); if (first) setTimeout(function () { first.focus({ preventScroll: true }); }, 50);
    }
    function cueSheet(id) {
      var c = state.cueById[id], el = document.getElementById('cue-' + id), para = el && el.closest('.para'), pi = locAt(id), items = [];
      items.push(['▶ 从这句播放', function () { localSeekGuard(); resumeFollow(); seekKeep(c.s); }]);
      items.push(['🔁 循环这句', function () { localSeekGuard(); loopCue(id); }]);
      if (para) items.push(['🔁 循环这一段', function () { localSeekGuard(); loopPara(+para.dataset.lo, +para.dataset.hi); }, { sub: (SPK_NAME[para.dataset.speaker] || para.dataset.speaker) + ' 的一轮 · ' + (+para.dataset.hi - +para.dataset.lo + 1) + ' 句' }]);
      if (pi >= 0) items.push(['🔁 循环漏听 #' + state.locOrder[pi], function () { localSeekGuard(); setLoop(state.located[pi]); }, { sub: esc(state.located[pi].label || '') }]);
      if (state.blind && para) { var lo = +para.dataset.lo, hi = +para.dataset.hi, shown = state.revealed.has(id); items.push([shown ? '盖上这一段' : '揭开这一段', function () { setRevealed([lo, hi], !shown); }]); }
      items.push(['★ 标记为关键句', function () { markKey([id, id]); }, { sub: pi >= 0 ? '归入漏听 #' + state.locOrder[pi] : '尚无所属段落，将一并建段' }]);
      items.push(['⟷ 从这句圈段…', function () { startRange(id); }, { sub: '再轻点终点句，保存为漏听段落或关键句' }]);
      items.push(['✎ 选词标注', function () { setAnnotating(true); }]);
      if (pi >= 0) items.push(['编辑漏听 #' + state.locOrder[pi] + '…', function () { locSheet(pi); }]);
      items.push(['复制英文', function () { navigator.clipboard.writeText(c.en).then(function () { toast('已复制'); }, function () { toast('复制失败'); }); }]);
      menu(fmt(c.s) + ' · ' + esc(c.en), items);
    }
    function loopSheet() {
      var id = state.activeCue, el = id !== null ? document.getElementById('cue-' + id) : null, para = el && el.closest('.para'), pi = locAt(id), items = [];
      if (id !== null) items.push(['循环当前句', function () { localSeekGuard(); loopCue(id); }, { sub: esc(state.cueById[id].en) }]);
      if (para) items.push(['循环当前段', function () { localSeekGuard(); loopPara(+para.dataset.lo, +para.dataset.hi); }, { sub: (SPK_NAME[para.dataset.speaker] || para.dataset.speaker) + ' 的一轮 · ' + (+para.dataset.hi - +para.dataset.lo + 1) + ' 句' }]);
      if (pi >= 0) items.push(['循环所在漏听 #' + state.locOrder[pi], function () { localSeekGuard(); setLoop(state.located[pi]); }, { sub: esc(state.located[pi].label || '') }]);
      if (state.loop) items.push(['停止循环', function () { setLoop(null); }, { cls: 'del' }]);
      if (!items.length) { toast('先播放到某一句'); return; }
      menu('循环范围', items);
    }
    function locSheet(ri) {
      var p = state.located[ri]; if (!p) return; var n = state.locOrder[ri], items = [];
      items.push(['↦ 定位到本段', function () { localSeekGuard(); setLoop(null); resumeFollow(); seekKeep(p.startTime); }]);
      items.push(['🔁 循环本段', function () { localSeekGuard(); setLoop(p); }]);
      items.push(['✎ 改标签与起止时间', function () { locEditForm(ri); }]);
      if (p.sentences.length === 0 && containingParagraph(p.cues, ri) >= 0) items.push(['归入上级段落', function () { attachParagraph(ri); }, { sub: '成为包含它的段落的关键句' }]);
      items.push(['删除本段' + (p.sentences.length ? '（连同 ' + p.sentences.length + ' 个关键句）' : ''), function () { menu('确认删除漏听 #' + n + '？', [['删除', function () { state.located.splice(ri, 1); commit('已删除'); }, { cls: 'del' }]]); }, { cls: 'del' }]);
      menu('漏听 #' + n + ' · ' + esc(p.label || '段落') + ' · ' + fmt(p.startTime) + '–' + fmt(p.endTime), items);
    }
    function locEditForm(ri) {
      var p = state.located[ri];
      form('编辑漏听 #' + state.locOrder[ri], '<label>标签<input id="f-label" value="' + esc(p.label || '') + '"></label><div class="two"><label>开始 m:ss.s<input id="f-a" inputmode="decimal" value="' + fmtIn(p.startTime) + '"></label><label>结束 m:ss.s<input id="f-b" inputmode="decimal" value="' + fmtIn(p.endTime) + '"></label></div>',
        [['保存', function () { return applyEdit(ri, $('f-label').value, $('f-a').value, $('f-b').value); }]]);
    }
    function keySheet(pi, si) {
      var sn = state.located[pi].sentences[si], items = [];
      items.push(['🔁 循环本句', function () { localSeekGuard(); setLoop({ startTime: sn.startTime, endTime: sn.endTime, label: '句' + (si + 1) + (sn.label ? ' ' + sn.label : ''), cues: sn.cues }); }]);
      items.push(['↦ 定位', function () { localSeekGuard(); setLoop(null); resumeFollow(); seekKeep(sn.startTime); }]);
      items.push(['✎ 改标签', function () { form('关键句标签', '<label>标签<input id="f-label" value="' + esc(sn.label || '') + '"></label>', [['保存', function () { sn.label = $('f-label').value.trim(); commit('已改标签'); }]]); }]);
      items.push(['⤴ 提升为独立漏听段落', function () { state.located[pi].sentences.splice(si, 1); state.located.push({ label: sn.label, startTime: sn.startTime, endTime: sn.endTime, cues: sn.cues, sentences: [], createdAt: sn.createdAt || Date.now() }); commit('已提升为独立漏听段落'); }]);
      items.push(['删除这句关键句', function () { state.located[pi].sentences.splice(si, 1); commit('已删除关键句'); }, { cls: 'del' }]);
      menu('关键句 句' + (si + 1) + (sn.label ? '：' + esc(sn.label) : '') + ' · 属于漏听 #' + state.locOrder[pi], items);
    }
    function highlightSheet(h) {
      var kinds = [['vocab', '生词 [[ ]]'], ['collocation', '搭配 / 语法'], ['question', '疑问']];
      form('编辑标注', '<p class="q">“' + esc(h.text) + '”</p><div class="seg" id="f-kinds">' + kinds.map(function (k) { return '<button type="button" data-k="' + k[0] + '"' + (k[0] === h.kind ? ' class="active"' : '') + '>' + k[1] + '</button>'; }).join('') + '</div><label>备注 / 问题<input id="f-note" value="' + esc(h.note || '') + '" placeholder="疑问必填，其余可选"></label>',
        [['保存', function () { var kind = sheet.querySelector('#f-kinds .active').dataset.k, note = $('f-note').value.trim(); if (kind === 'question' && !note) { toast('请先写下问题'); return false; } h.kind = kind; h.note = note; saveHighlights(); rerenderCue(h.cue); renderStats(); toast('已保存标注'); }],
         ['删除', function () { delete state.highlights[h.id]; saveHighlights(); rerenderCue(h.cue); renderStats(); toast('已删除标注'); }]]);
      sheet.querySelectorAll('#f-kinds button').forEach(function (b) { b.onclick = function () { sheet.querySelectorAll('#f-kinds button').forEach(function (x) { x.classList.toggle('active', x === b); }); }; });
      var del = sheet.querySelector('.row button[data-i="1"]'); del.classList.add('del'); del.classList.remove('primary');
    }
    function moreSheet() {
      closePop(); closeDrawer();
      var hs = Object.keys(state.highlights).length, hasVideo = document.body.classList.contains('has-video');
      sheet.innerHTML = '<h3>' + esc($('title').textContent) + '</h3>' +
        '<div class="grp">段落标记（听力层 · segments.json）</div><div class="items">' +
        '<button type="button" data-a="range">按播放位置圈段<small>起点 = 当前播放处；播放到终点后按情境条里的「终点 = 播放处」</small></button>' +
        '<button type="button" data-a="exp-seg">导出 segments.json<small>' + state.located.length + ' 段</small></button>' +
        '<button type="button" data-a="imp-seg">导入 segments.json<small>替换当前全部段落标记</small></button>' +
        '<button type="button" data-a="reset-seg">重置为文件版<small>丢弃本机对段落标记的编辑</small></button></div>' +
        '<div class="grp">词句标注（阅读层 · highlights.json）</div><div class="items">' +
        '<button type="button" data-a="copy">复制标注文本<small>带 [[ ]] 的英文句，可直接交给学习助手</small></button>' +
        '<button type="button" data-a="exp-hl">导出 highlights.json<small>' + hs + ' 条</small></button>' +
        '<button type="button" data-a="imp-hl">导入 highlights.json</button>' +
        '<button type="button" data-a="clear-hl" class="del">清空本篇全部标注</button></div>' +
        (hasVideo ? '<div class="grp">视频</div><div class="items"><button type="button" data-a="vhide">' + (state.videoHidden ? '展开画面' : '收起画面，只听声音') + '</button><button type="button" data-a="vsub">画面字幕：' + (state.videoSub ? '开' : '关') + '</button><button type="button" data-a="vmask">蒙版：' + (state.mask.on ? '开' : '关') + '</button></div>' : '') +
        '<div class="grp">关于</div><p class="about">' + state.cues.length + ' 句 · 标注与标记按本机自动保存<br>轻点句子：定位播放；遮盖时揭开 / 盖回；标注时选词<br>长按句子：更多操作 · 长按 🔁：选循环范围<br>手动滚动会暂停跟随，点「回到当前句」恢复</p>' +
        '<button type="button" class="cancel">关闭</button>';
      var acts = {
        range: function () { var c = findCue(mediaEl().currentTime); if (!c) { toast('先播放到某一句'); return; } startRange(c.i); },
        'exp-seg': exportSegments, 'imp-seg': function () { $('seg-file').click(); }, 'reset-seg': resetLocated,
        copy: function () { var t = passagesText(); if (!t) { toast('还没有标注'); return; } navigator.clipboard.writeText(t).then(function () { toast('已复制标注文本'); }, function () { toast('复制失败'); }); },
        'exp-hl': function () { download((state.data.slug || 'transcript') + '.highlights.json', JSON.stringify(exportData(), null, 2)); toast('已导出 .highlights.json'); },
        'imp-hl': function () { $('hl-file').click(); },
        'clear-hl': function () { if (!hs) { toast('没有标注'); return; } menu('清空本篇全部 ' + hs + ' 条标注？', [['清空', function () { state.highlights = {}; saveHighlights(); render(); toast('已清空'); }, { cls: 'del' }]]); },
        vhide: function () { state.videoHidden = !state.videoHidden; applyVideoPrefs(); savePrefs(); },
        vsub: function () { state.videoSub = !state.videoSub; applyVideoPrefs(); savePrefs(); },
        vmask: function () { state.mask.on = !state.mask.on; applyMask(); savePrefs(); }
      };
      sheet.querySelectorAll('[data-a]').forEach(function (b) { b.onclick = function () { closeSheet(); acts[b.dataset.a](); }; });
      sheet.querySelector('.cancel').onclick = closeSheet;
      openSheet();
    }

    // ---------- 与核心同步 ----------
    function sync() {
      if (!mounted) return;
      $('t-title').textContent = $('title').textContent;
      $('t-mode').textContent = MODE_SHORT[state.zhMode] || 'Aa'; $('t-mode').classList.toggle('covered', state.blind);
      $('t-rate').textContent = state.speed + '×';
      $('t-annotate').textContent = annotating ? '完成' : '标注'; $('t-annotate').classList.toggle('active', annotating); $('t-annotate').setAttribute('aria-pressed', String(annotating));
      $('t-loop').classList.toggle('active', !!state.loop);
      if (state.loop) $('t-looplabel').textContent = state.loop.label || fmt(state.loop.start);
      syncDrawerFoot(); syncTransport(); renderPop();
    }
    function escape() {
      if (!mounted) return false;
      if (!pop.hidden) { closePop(); return true; }
      if (sheet.open) { closeSheet(); return true; }
      if (pick) { clearPick(); return true; }
      if (range) { clearRange(); return true; }
      if (annotating) { setAnnotating(false); return true; }
      if (document.body.classList.contains('t-drawer-open')) { closeDrawer(); return true; }
      return false;
    }
    return { mount: mount, unmount: unmount, sync: sync, syncTransport: syncTransport, renderMarks: renderMarks, loopTime: loopTime, setAnnotating: setAnnotating, keySheet: keySheet, highlightSheet: highlightSheet, locSheet: locSheet, escape: escape, closeDrawer: closeDrawer,
             followAllowed: function () { return !mounted || (!annotating && !followSuspended && !range && !pick); },
             bottomInset: function () { return mounted ? bar.offsetHeight + (ctx.hidden ? 0 : ctx.offsetHeight + 8) : 0; },
             markProgrammatic: function () { programmaticUntil = Date.now() + 900; },
             resumeFollow: resumeFollow, onCueChange: updatePill, isAnnotating: function () { return annotating; },
             debug: function () { return { mounted: mounted, annotating: annotating, followSuspended: followSuspended, programmaticUntil: programmaticUntil, range: range, pick: pick, popKind: popKind, sheetOpen: sheet.open }; } };
  })();

  // ---------- 启动 ----------
  if (/[?&]debug=1/.test(location.search)) window.__transcriptDebug = function () { return Touch.debug(); };
  loadPrefs();
  if (isMobileReader()) Touch.mount();
  try { var embedded = JSON.parse($('embedded-data').textContent); if (embedded && embedded.cues) { loadData(embedded); onTimeUpdate(); } } catch (e) { console.warn('embedded data invalid', e); }
  mobileQuery.addEventListener('change', function () {
    switchLinkProfile();
    if (isMobileReader()) { if (state.selecting) toggleSelecting(false); cancelMark(); hidePopover(); Touch.mount(); } else Touch.unmount();
    applyBlind(); applyFollowButtons(); document.querySelectorAll('.reading-guide').forEach(function (guide) { guide.open = !isMobileReader(); });
  });

})();
</script>
<script src="./media-config.js"></script>
<script src="./pwa.js"></script>
</body>
</html>
