    return '<div class="loc-head" id="loc-' + ri + '"><span class="loc-num">漏听 #' + n + '</span><span class="loc-label">' + esc(p.label || '段落') + '</span>' +
      '<span class="t">' + fmt(p.startTime) + '–' + fmt(p.endTime) + (p.sentences.length ? ' · ' + p.sentences.length + ' 关键句' : '') + (ov.length ? ' · 与 ' + ov.join('、') : '') + '</span>' +
      '<button data-play="' + ri + '" title="跳转到本段，保持播放或暂停">↦ 定位</button><button data-loop="' + ri + '" title="循环本段">🔁 循环</button>' +
