  function sizeModeButtons() {
    var probe = document.createElement('button'), host = $('zh-cycle').parentNode, w = 0;
    probe.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;left:-9999px'; host.appendChild(probe);
    Object.keys(MODE_NAME).forEach(function (k) { probe.textContent = '⇄ ' + MODE_NAME[k]; w = Math.max(w, probe.getBoundingClientRect().width); });
    probe.remove(); $('zh-cycle').style.minWidth = $('zh-flip').style.minWidth = Math.ceil(w) + 'px';
  }
  function setZhMode(m) {
    if (!MODE_NAME[m]) return;
