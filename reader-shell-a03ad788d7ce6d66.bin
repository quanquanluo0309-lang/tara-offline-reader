    document.body.classList.toggle('show-blind', state.blind); document.body.classList.toggle('show-blind-peek', isMobileReader() ? false : state.blindPeek); document.body.classList.toggle('show-blind-para', isMobileReader() ? false : state.blindPara);
    $('blind').classList.toggle('active', state.blind); $('blind-peek').classList.toggle('active', state.blindPeek); $('blind-peek').disabled = !state.blind;
