      if (p.zhMode && MODE_NAME[p.zhMode]) state.zhMode = p.zhMode; if (p.zhPrev && MODE_NAME[p.zhPrev]) state.zhPrev = p.zhPrev; if (typeof p.blind === 'boolean') state.blind = p.blind; if (typeof p.blindPeek === 'boolean') state.blindPeek = p.blindPeek; if (typeof p.blindPara === 'boolean') state.blindPara = p.blindPara; loadLinkPrefs(p); if (p.side === false) document.body.classList.add('side-hidden'); if (p.locSort === 'outline' || p.locSort === 'time') state.locSort = p.locSort;
      if (Number.isFinite(p.speed) && p.speed >= .25 && p.speed <= 4) state.speed = p.speed; if (/^[sml]$/.test(p.videoSize || '')) state.videoSize = p.videoSize; if (typeof p.videoSub === 'boolean') state.videoSub = p.videoSub; if (typeof p.videoHidden === 'boolean') state.videoHidden = p.videoHidden;
